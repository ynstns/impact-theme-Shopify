{% doc %}
  @prompt
    je veut que tu me genere un avant apres en format 1,1 et je peut slide pour mettre le avant apres , ajoute des fleche sur le curseur et essazye de arrondsir les coins de l'image ,
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-before-after-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }}}
.ai-before-after-{{ ai_gen_id }}__frame{position:relative;width:100%;aspect-ratio:1/1;overflow:hidden;border-radius:{{ block.settings.border_radius }}px;background:{{ block.settings.empty_background }};isolation:isolate;touch-action:none}
.ai-before-after-{{ ai_gen_id }}__image,.ai-before-after-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%}.ai-before-after-{{ ai_gen_id }}__image{display:block;object-fit:cover}.ai-before-after-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center}.ai-before-after-{{ ai_gen_id }}__placeholder svg{width:55%;height:55%;opacity:.35}.ai-before-after-{{ ai_gen_id }}__empty{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);width:calc(100% - 32px);text-align:center;font-size:13px}
.ai-before-after-{{ ai_gen_id }}__after{position:absolute;inset:0;width:var(--ai-position);overflow:hidden;border-right:{{ block.settings.divider_width }}px solid {{ block.settings.divider_color }};z-index:2}.ai-before-after-{{ ai_gen_id }}__after .ai-before-after-{{ ai_gen_id }}__image{width:calc(100% / var(--ai-position-number));max-width:none}
.ai-before-after-{{ ai_gen_id }}__handle{position:absolute;top:50%;left:var(--ai-position);z-index:3;width:{{ block.settings.handle_size }}px;height:{{ block.settings.handle_size }}px;transform:translate(-50%,-50%);display:flex;align-items:center;justify-content:center;border:2px solid {{ block.settings.handle_border }};border-radius:50%;background:{{ block.settings.handle_background }};color:{{ block.settings.handle_icon }};cursor:ew-resize;box-shadow:0 2px 10px rgba(0,0,0,.18);padding:0}.ai-before-after-{{ ai_gen_id }}__handle:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:3px}.ai-before-after-{{ ai_gen_id }}__handle svg{width:26px;height:26px}
.ai-before-after-{{ ai_gen_id }}__label{position:absolute;top:16px;z-index:4;padding:7px 11px;border-radius:999px;background:{{ block.settings.label_background }};color:{{ block.settings.label_text }};font-size:12px;font-weight:600;line-height:1;pointer-events:none}.ai-before-after-{{ ai_gen_id }}__label--before{left:16px}.ai-before-after-{{ ai_gen_id }}__label--after{right:16px}
{% endstyle %}
<before-after-slider-{{ ai_gen_id }} class="ai-before-after-{{ ai_gen_id }}" {{ block.shopify_attributes }} style="--ai-position:{{ block.settings.start_position }}%;--ai-position-number:{{ block.settings.start_position | divided_by:100.0 }}">
<div class="ai-before-after-{{ ai_gen_id }}__frame" aria-label="{{ block.settings.aria_label | escape }}">
{% if block.settings.before_image %}<img class="ai-before-after-{{ ai_gen_id }}__image" src="{{ block.settings.before_image | image_url: width:1600 }}" alt="{{ block.settings.before_image.alt | default: block.settings.before_label | escape }}" loading="lazy" width="{{ block.settings.before_image.width }}" height="{{ block.settings.before_image.height }}">{% else %}<div class="ai-before-after-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-before-after-{{ ai_gen_id }}__empty">Ajoutez l’image « avant »</span></div>{% endif %}
<div class="ai-before-after-{{ ai_gen_id }}__after">{% if block.settings.after_image %}<img class="ai-before-after-{{ ai_gen_id }}__image" src="{{ block.settings.after_image | image_url: width:1600 }}" alt="{{ block.settings.after_image.alt | default: block.settings.after_label | escape }}" loading="lazy" width="{{ block.settings.after_image.width }}" height="{{ block.settings.after_image.height }}">{% endif %}</div>
<span class="ai-before-after-{{ ai_gen_id }}__label ai-before-after-{{ ai_gen_id }}__label--before">{{ block.settings.before_label }}</span><span class="ai-before-after-{{ ai_gen_id }}__label ai-before-after-{{ ai_gen_id }}__label--after">{{ block.settings.after_label }}</span>
<button class="ai-before-after-{{ ai_gen_id }}__handle" type="button" aria-label="Déplacer le curseur avant après" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ block.settings.start_position }}" role="slider"><svg viewBox="0 0 32 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4 2 12l8 8M22 4l8 8-8 8M3 12h26"/></svg></button>
</div></before-after-slider-{{ ai_gen_id }}>
<script>(function(){class BeforeAfterSlider{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.frame=this.querySelector('.ai-before-after-{{ ai_gen_id }}__frame');this.handle=this.querySelector('.ai-before-after-{{ ai_gen_id }}__handle');this.frame.addEventListener('pointerdown',e=>this.start(e));this.handle.addEventListener('keydown',e=>this.key(e))}start(e){e.preventDefault();this.move(e);this.frame.setPointerCapture(e.pointerId);this.moveBound=e=>this.move(e);this.frame.addEventListener('pointermove',this.moveBound);this.frame.addEventListener('pointerup',()=>this.frame.removeEventListener('pointermove',this.moveBound),{once:true})}move(e){let r=this.frame.getBoundingClientRect(),v=Math.max(0,Math.min(100,(e.clientX-r.left)/r.width*100));this.update(v)}key(e){let v=+this.handle.getAttribute('aria-valuenow');if(e.key==='ArrowLeft')v-=1;else if(e.key==='ArrowRight')v+=1;else return;e.preventDefault();this.update(Math.max(0,Math.min(100,v)))}update(v){this.style.setProperty('--ai-position',v+'%');this.style.setProperty('--ai-position-number',v/100);this.handle.setAttribute('aria-valuenow',Math.round(v))}}customElements.define('before-after-slider-{{ ai_gen_id }}',BeforeAfterSlider{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Avant après carré","tag":null,"class":"before-after-block","settings":[{"type":"header","content":"Images"},{"type":"image_picker","id":"before_image","label":"Image avant"},{"type":"image_picker","id":"after_image","label":"Image après"},{"type":"text","id":"before_label","label":"Libellé avant","default":"Avant"},{"type":"text","id":"after_label","label":"Libellé après","default":"Après"},{"type":"text","id":"aria_label","label":"Description accessible","default":"Comparaison avant et après"},{"type":"range","id":"start_position","label":"Position de départ","min":10,"max":90,"step":5,"unit":"%","default":50},{"type":"range","id":"desktop_width_percent","label":"Largeur desktop","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Style"},{"type":"range","id":"border_radius","label":"Arrondi des coins","min":0,"max":40,"step":2,"unit":"px","default":16},{"type":"range","id":"handle_size","label":"Taille du curseur","min":32,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"divider_width","label":"Largeur de la séparation","min":1,"max":8,"step":1,"unit":"px","default":3},{"type":"color","id":"divider_color","label":"Couleur de la séparation","default":"#FFFFFF"},{"type":"color","id":"empty_background","label":"Fond vide","default":"#F5EDE0"},{"type":"color","id":"text_color","label":"Texte","default":"#2C1810"},{"type":"color","id":"label_background","label":"Fond des libellés","default":"#2C1810"},{"type":"color","id":"label_text","label":"Texte des libellés","default":"#FFFFFF"},{"type":"color","id":"handle_background","label":"Fond du curseur","default":"#FFFFFF"},{"type":"color","id":"handle_border","label":"Contour du curseur","default":"#2C1810"},{"type":"color","id":"handle_icon","label":"Icône du curseur","default":"#2C1810"},{"type":"color","id":"focus_color","label":"Contour de focus","default":"#5C3A21"}],"presets":[{"name":"Avant après carré"}]}{% endschema %}