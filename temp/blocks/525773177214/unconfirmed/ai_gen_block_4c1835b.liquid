{% doc %}
  @prompt
    trouve moi les truc ou ya les icone livraison gratuiut et tout 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-strip-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 18px 20px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-trust-strip__items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    align-items: center;
  }

  .ai-trust-strip__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 0;
    text-align: left;
  }

  .ai-trust-strip__icon-{{ ai_gen_id }} {
    display: inline-flex;
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-trust-strip__icon-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-trust-strip__label-{{ ai_gen_id }} {
    margin: 0;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 600;
  }

  @media screen and (max-width: 600px) {
    .ai-trust-strip-{{ ai_gen_id }} {
      padding: 16px 12px;
    }

    .ai-trust-strip__items-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .ai-trust-strip__item-{{ ai_gen_id }} {
      justify-content: flex-start;
    }
  }
{% endstyle %}

<div class="ai-trust-strip-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-strip__items-{{ ai_gen_id }}">
    <div class="ai-trust-strip__item-{{ ai_gen_id }}">
      <span class="ai-trust-strip__icon-{{ ai_gen_id }}" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M3 7h11v11H3z"/><path d="M14 10h4l3 3v5h-7z"/><circle cx="7.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/><path d="M3 10h7M3 13h5"/></svg>
      </span>
      <p class="ai-trust-strip__label-{{ ai_gen_id }}">{{ block.settings.delivery_text | escape }}</p>
    </div>
    <div class="ai-trust-strip__item-{{ ai_gen_id }}">
      <span class="ai-trust-strip__icon-{{ ai_gen_id }}" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 3 19 6v5c0 4.7-2.8 8-7 10-4.2-2-7-5.3-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
      </span>
      <p class="ai-trust-strip__label-{{ ai_gen_id }}">{{ block.settings.payment_text | escape }}</p>
    </div>
    <div class="ai-trust-strip__item-{{ ai_gen_id }}">
      <span class="ai-trust-strip__icon-{{ ai_gen_id }}" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 7h13v12H4z"/><path d="M7 7V5h7v2"/><path d="M17 10h3v9h-3"/><path d="m9 13 2 2 4-4"/></svg>
      </span>
      <p class="ai-trust-strip__label-{{ ai_gen_id }}">{{ block.settings.returns_text | escape }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Icônes de réassurance",
  "settings": [
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Livraison",
      "default": "Livraison offerte"
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "Paiement",
      "default": "Paiement sécurisé"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Retours",
      "default": "Retours faciles"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largeur sur ordinateur",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Arrière-plan",
      "default": "#FAF6F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texte",
      "default": "#2C1810"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icônes",
      "default": "#5C3A21"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Arrondi des coins",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Icônes de réassurance"
    }
  ],
  "tag": null,
  "class": "trust-icons-block"
}
{% endschema %}