          "settings": {
            "liquid": "{% comment %} ELIORA — Transformation timeline accordéon {% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .eli-transform {\n    font-family: 'Poppins', sans-serif;\n    color: #1A1A1A;\n    max-width: 640px;\n    margin: 0 auto;\n    padding: 40px 20px 48px;\n  }\n\n  /* HEADER */\n  .eli-transform__eyebrow {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    margin-bottom: 16px;\n  }\n  .eli-transform__eyebrow-line {\n    height: 1px;\n    width: 36px;\n    background: rgba(201,120,91,0.4);\n  }\n  .eli-transform__eyebrow-text {\n    font-size: 10.5px;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: #C9785B;\n    white-space: nowrap;\n  }\n  .eli-transform__title {\n    text-align: center;\n    font-size: clamp(24px, 5vw, 36px);\n    font-weight: 400;\n    line-height: 1.15;\n    letter-spacing: -0.02em;\n    margin: 0 0 8px;\n    color: #1A1A1A;\n  }\n  .eli-transform__title em {\n    font-style: italic;\n    font-weight: 400;\n    color: #C9785B;\n  }\n  .eli-transform__subtitle {\n    text-align: center;\n    font-size: 13.5px;\n    color: #8A8178;\n    margin: 0 0 32px;\n  }\n\n  /* TIMELINE */\n  .eli-transform__list {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n  }\n\n  /* Ligne verticale */\n  .eli-transform__list::before {\n    content: '';\n    position: absolute;\n    left: 22px;\n    top: 22px;\n    bottom: 22px;\n    width: 1.5px;\n    background: rgba(201,120,91,0.2);\n    z-index: 0;\n  }\n\n  /* ITEM */\n  .eli-transform__item { position: relative; }\n\n  /* ROW = numéro + header cliquable */\n  .eli-transform__row {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    cursor: pointer;\n    padding: 14px 0;\n    user-select: none;\n    -webkit-tap-highlight-color: transparent;\n    position: relative;\n    z-index: 1;\n  }\n\n  /* NUMÉRO */\n  .eli-transform__num {\n    width: 44px;\n    height: 44px;\n    min-width: 44px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 15px;\n    font-weight: 700;\n    flex-shrink: 0;\n    transition: background 0.25s, color 0.25s, border-color 0.25s;\n    background: #FFFFFF;\n    border: 2px solid rgba(201,120,91,0.25);\n    color: #8A8178;\n    z-index: 1;\n  }\n  .eli-transform__item.is-open .eli-transform__num {\n    background: #C9785B;\n    border-color: #C9785B;\n    color: #FFFFFF;\n  }\n\n  /* LABEL */\n  .eli-transform__label {\n    flex: 1;\n    font-size: 16px;\n    font-weight: 600;\n    color: #8A8178;\n    transition: color 0.25s;\n    line-height: 1.2;\n  }\n  .eli-transform__item.is-open .eli-transform__label {\n    color: #C9785B;\n  }\n\n  /* CHEVRON */\n  .eli-transform__chevron {\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    background: #FAF6F0;\n    border: 1px solid rgba(201,120,91,0.15);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    transition: background 0.25s, transform 0.3s;\n  }\n  .eli-transform__item.is-open .eli-transform__chevron {\n    background: #C9785B;\n    transform: rotate(180deg);\n  }\n  .eli-transform__chevron svg {\n    width: 14px; height: 14px;\n    stroke: #C9785B; fill: none;\n    stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;\n    transition: stroke 0.25s;\n  }\n  .eli-transform__item.is-open .eli-transform__chevron svg {\n    stroke: #FFFFFF;\n  }\n\n  /* CONTENU */\n  .eli-transform__body {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.4s ease;\n  }\n  .eli-transform__item.is-open .eli-transform__body {\n    max-height: 900px;\n  }\n  .eli-transform__body-inner {\n    padding: 4px 0 20px 60px;\n  }\n  .eli-transform__body-title {\n    font-size: 16px;\n    font-weight: 700;\n    color: #1A1A1A;\n    margin: 0 0 10px;\n    line-height: 1.3;\n  }\n  .eli-transform__body-text {\n    font-size: 14px;\n    line-height: 1.7;\n    color: #4A4640;\n    margin: 0 0 18px;\n  }\n  .eli-transform__body-text strong {\n    font-weight: 700;\n    color: #1A1A1A;\n  }\n  .eli-transform__body-img {\n    width: 100%;\n    border-radius: 14px;\n    object-fit: cover;\n    display: block;\n    aspect-ratio: 4/3;\n    background: #EDE6DC;\n  }\n  .eli-transform__body-img-placeholder {\n    width: 100%;\n    border-radius: 14px;\n    background: #EDE6DC;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    aspect-ratio: 4/3;\n  }\n  .eli-transform__body-img-placeholder svg {\n    width: 40px; height: 40px;\n    stroke: #C9785B; fill: none;\n    stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round;\n    opacity: 0.4;\n  }\n\n  /* Séparateur entre items */\n  .eli-transform__item:not(:last-child) .eli-transform__row {\n    border-bottom: 1px solid rgba(26,26,26,0.06);\n  }\n  .eli-transform__item.is-open .eli-transform__row {\n    border-bottom: none;\n  }\n\n  @media (max-width: 480px) {\n    .eli-transform__label { font-size: 15px; }\n    .eli-transform__body-inner { padding-left: 52px; }\n    .eli-transform__body-title { font-size: 15px; }\n    .eli-transform__body-text { font-size: 13px; }\n  }\n</style>\n\n<div class=\"eli-transform\">\n\n  <!-- HEADER -->\n  <div class=\"eli-transform__eyebrow\">\n    <span class=\"eli-transform__eyebrow-line\"></span>\n    <span class=\"eli-transform__eyebrow-text\">Votre transformation</span>\n    <span class=\"eli-transform__eyebrow-line\"></span>\n  </div>\n  <h2 class=\"eli-transform__title\">\n    À quoi s'attendre<br>\n    <em>avec Eliora.</em>\n  </h2>\n  <p class=\"eli-transform__subtitle\">3 étapes. De la première gélule au ventre léger.</p>\n\n  <!-- TIMELINE -->\n  <div class=\"eli-transform__list\">\n\n    <!-- ÉTAPE 1 — ouverte par défaut -->\n    <div class=\"eli-transform__item is-open\">\n      <div class=\"eli-transform__row\">\n        <span class=\"eli-transform__num\">1</span>\n        <span class=\"eli-transform__label\">Jours 1–7</span>\n        <span class=\"eli-transform__chevron\">\n          <svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </span>\n      </div>\n      <div class=\"eli-transform__body\">\n        <div class=\"eli-transform__body-inner\">\n          <p class=\"eli-transform__body-title\">Les premières sensations de légèreté.</p>\n          <p class=\"eli-transform__body-text\">\n            La plupart observent <strong>moins de ballonnements après les repas</strong>.\n            Le charbon végétal commence à capturer les gaz excédentaires.\n            Votre ventre se sent plus <strong>à l'aise en fin de journée</strong> — moins de lourdeur, moins de gêne.\n          </p>\n          <!-- ⬇️ Remplace src par ta vraie photo -->\n          <div class=\"eli-transform__body-img-placeholder\">\n            <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><polyline points=\"21 15 16 10 5 21\"/></svg>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ÉTAPE 2 -->\n    <div class=\"eli-transform__item\">\n      <div class=\"eli-transform__row\">\n        <span class=\"eli-transform__num\">2</span>\n        <span class=\"eli-transform__label\">Semaines 2–4</span>\n        <span class=\"eli-transform__chevron\">\n          <svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </span>\n      </div>\n      <div class=\"eli-transform__body\">\n        <div class=\"eli-transform__body-inner\">\n          <p class=\"eli-transform__body-title\">Un confort digestif visible au quotidien.</p>\n          <p class=\"eli-transform__body-text\">\n            La digestion s'apaise progressivement. La plupart voient leur <strong>ventre du soir ressembler davantage à celui du matin</strong>.\n            Les gaz et inconforts après les repas <strong>diminuent nettement</strong>.\n            Le jean qu'on évitait commence à rentrer à nouveau.\n          </p>\n          <div class=\"eli-transform__body-img-placeholder\">\n            <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><polyline points=\"21 15 16 10 5 21\"/></svg>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ÉTAPE 3 -->\n    <div class=\"eli-transform__item\">\n      <div class=\"eli-transform__row\">\n        <span class=\"eli-transform__num\">3</span>\n        <span class=\"eli-transform__label\">Mois 2–3</span>\n        <span class=\"eli-transform__chevron\">\n          <svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"/></svg>\n        </span>\n      </div>\n      <div class=\"eli-transform__body\">\n        <div class=\"eli-transform__body-inner\">\n          <p class=\"eli-transform__body-title\">Le ventre léger s'installe durablement.</p>\n          <p class=\"eli-transform__body-text\">\n            Le confort digestif devient votre nouvelle normalité. <strong>Vous mangez sans appréhension</strong>,\n            sans déboutonner votre jean, sans éviter les repas en société.\n            Le phénouil et le gingembre ont <strong>rééquilibré durablement votre digestion</strong> — le résultat tient dans le temps.\n          </p>\n          <div class=\"eli-transform__body-img-placeholder\">\n            <svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"/><polyline points=\"21 15 16 10 5 21\"/></svg>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function() {\n  var items = document.querySelectorAll('.eli-transform__item');\n  items.forEach(function(item) {\n    var body = item.querySelector('.eli-transform__body');\n    /* Init hauteur */\n    if (item.classList.contains('is-open')) {\n      body.style.maxHeight = body.scrollHeight + 'px';\n    }\n    item.querySelector('.eli-transform__row').addEventListener('click', function() {\n      var isOpen = item.classList.contains('is-open');\n      /* Ferme tout */\n      items.forEach(function(i) {\n        i.classList.remove('is-open');\n        i.querySelector('.eli-transform__body').style.maxHeight = '0px';\n      });\n      /* Ouvre celui cliqué si était fermé */\n      if (!isOpen) {\n        item.classList.add('is-open');\n        body.style.maxHeight = body.scrollHeight + 'px';\n      }\n    });\n  });\n  window.addEventListener('resize', function() {\n    items.forEach(function(item) {\n      if (item.classList.contains('is-open')) {\n        item.querySelector('.eli-transform__body').style.maxHeight =\n          item.querySelector('.eli-transform__body').scrollHeight + 'px';\n      }\n    });\n  });\n})();\n</script>"
          }
        }
      },
