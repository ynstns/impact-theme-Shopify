on\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M3 12h4l3 8 4-16 3 8h4\"/></svg>\n      </div>\n      <div class=\"aur-hero__benefit-body\">\n        <p class=\"aur-hero__benefit-title\">Sans plastique</p>\n        <p class=\"aur-hero__benefit-text\">100% coton bio & cire d'abeille</p>\n      </div>\n    </div>\n\n    <div class=\"aur-hero__benefit\">\n      <div class=\"aur-hero__benefit-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M21 2v6h-6\"/><path d=\"M3 12a9 9 0 0 1 15-6.7L21 8\"/><path d=\"M3 22v-6h6\"/><path d=\"M21 12a9 9 0 0 1-15 6.7L3 16\"/></svg>\n      </div>\n      <div class=\"aur-hero__benefit-body\">\n        <p class=\"aur-hero__benefit-title\">Respirant</p>\n        <p class=\"aur-hero__benefit-text\">Zéro moisissure, zéro humidité</p>\n      </div>\n    </div>\n\n    <div class=\"aur-hero__benefit\">\n      <div class=\"aur-hero__benefit-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z\"/><path d=\"M2 21c0-3 1.85-5.36 5.08-6\"/></svg>\n      </div>\n      <div class=\"aur-hero__benefit-body\">\n        <p class=\"aur-hero__benefit-title\">Réutilisable des années</p>\n        <p class=\"aur-hero__benefit-text\">Se lave à l'eau froide, zéro déchet</p>\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"aur-hero__stock\">\n    <div class=\"aur-hero__stock-track\">\n      <div class=\"aur-hero__stock-fill\" id=\"aurStockFill\"></div>\n    </div>\n    <span class=\"aur-hero__stock-label\">89% <span>VENDU</span></span>\n  </div>\n\n</div>\n\n<script>\n  (function() {\n    var fill = document.getElementById('aurStockFill');\n    if (!fill) return;\n    function go() { fill.classList.add('is-filled'); }\n    if ('IntersectionObserver' in window) {\n      var obs = new IntersectionObserver(function(entries) {\n        entries.forEach(function(e) {\n          if (e.isIntersecting) { go(); obs.disconnect(); }\n        });\n      }, { threshold: 0.4 });\n  