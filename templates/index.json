          "type": "liquid",
          "settings": {
            "liquid": "{% comment %} AURALIS — Bloc héro produit compact mobile {% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .aur-hero {\n    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;\n    color: #1A1A1A;\n    max-width: 640px;\n    margin: 0 auto;\n    padding: 6px 2px;\n    background: #FFFFFF;\n  }\n\n  .aur-hero__rating {\n    display: flex;\n    align-items: center;\n    flex-wrap: nowrap;\n    gap: 4px;\n    font-size: 11px;\n    margin-bottom: 8px;\n    overflow: hidden;\n  }\n  .aur-hero__stars { display: inline-flex; gap: 1px; flex-shrink: 0; }\n  .aur-hero__stars svg { width: 11px; height: 11px; fill: #C68B3D; }\n  .aur-hero__rating-note { font-weight: 600; flex-shrink: 0; }\n  .aur-hero__rating-note em { font-style: italic; font-weight: 500; }\n  .aur-hero__rating-sep { color: #C68B3D; flex-shrink: 0; }\n  .aur-hero__rating-count { font-weight: 600; flex-shrink: 0; }\n\n  .aur-hero__badges {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 4px 10px;\n    font-size: 10.5px;\n    font-weight: 600;\n    color: #5C3A21;\n    margin-bottom: 8px;\n  }\n  .aur-hero__badges-sep { color: #C68B3D; }\n\n  .aur-hero__eyebrow {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #5C3A21;\n    margin: 0 0 5px;\n  }\n\n  .aur-hero__title {\n    font-size: clamp(28px, 7.5vw, 42px);\n    font-weight: 400;\n    line-height: 1.08;\n    letter-spacing: -0.02em;\n    margin: 0 0 10px;\n    color: #1A1A1A;\n  }\n  .aur-hero__title em {\n    font-style: italic;\n    font-weight: 400;\n    color: #C68B3D;\n  }\n\n  .aur-hero__divider {\n    width: 44px;\n    height: 2.5px;\n    background: #C68B3D;\n    border-radius: 2px;\n    margin-bottom: 16px;\n  }\n\n  .aur-hero__benefits {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px 12px;\n    margin-bottom: 18px;\n  }\n  .aur-hero__benefit {\n    display: flex;\n    align-items: flex-start;\n    gap: 9px;\n    min-width: 0;\n  }\n  .aur-hero__benefit-icon {\n    width: 30px;\n    height: 30px;\n    min-width: 30px;\n    border-radius: 50%;\n    background: rgba(198,139,61,0.14);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .aur-hero__benefit-icon svg {\n    width: 14px;\n    height: 14px;\n    stroke: #C68B3D;\n    fill: none;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n  .aur-hero__benefit-body { min-width: 0; }\n  .aur-hero__benefit-title {\n    font-size: 13px;\n    font-weight: 600;\n    line-height: 1.2;\n    margin: 0 0 2px;\n    color: #1A1A1A;\n  }\n  .aur-hero__benefit-text {\n    font-size: 11.5px;\n    font-weight: 400;\n    line-height: 1.3;\n    color: #8A8178;\n    margin: 0;\n  }\n\n  .aur-hero__stock {\n    background: #FFFFFF;\n    border-radius: 12px;\n    padding: 12px 14px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .aur-hero__stock-track {\n    flex: 1;\n    height: 10px;\n    background: #EDE6DC;\n    border-radius: 20px;\n    overflow: hidden;\n  }\n  .aur-hero__stock-fill {\n    height: 100%;\n    width: 0;\n    background: linear-gradient(90deg, #8A5A1F 0%, #C68B3D 100%);\n    border-radius: 20px;\n    transition: width 1.6s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n  .aur-hero__stock-fill.is-filled { width: 89%; }\n  .aur-hero__stock-label {\n    font-size: 16px;\n    font-weight: 700;\n    color: #5C3A21;\n    white-space: nowrap;\n    flex-shrink: 0;\n    letter-spacing: -0.01em;\n  }\n  .aur-hero__stock-label span {\n    font-size: 10px;\n    font-weight: 600;\n    color: #8A8178;\n    letter-spacing: 0.08em;\n    margin-left: 3px;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .aur-hero__stock-fill { transition: none; }\n  }\n</style>\n\n<div class=\"aur-hero\">\n\