a(198,139,61,.28);\n}\n.avd__eyebrow{\n  display:inline-block;\n  margin:34px 0 26px;\n  font-size:11px;\n  letter-spacing:.24em;\n  text-transform:uppercase;\n  color:#C68B3D;\n  font-weight:600;\n}\n.avd__logos{\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  flex-wrap:wrap;\n  gap:30px 60px;\n}\n.avd__logo{\n  display:block;\n}\n.avd__logo img{\n  height:34px;\n  width:auto;\n  display:block;\n  filter:grayscale(100%);\n  opacity:.85;\n  transition:.3s ease;\n}\n.avd__logo:hover img{\n  filter:grayscale(0);\n  opacity:1;\n}\n.avd__logo--mono img{\n  filter:brightness(0);\n  opacity:1;\n  background:transparent;\n}\n.avd__logo--mono:hover img{\n  filter:brightness(0);\n  opacity:1;\n}\n.avd__dash{\n  display:block;\n  width:38px;\n  height:1px;\n  background:#5C3A21;\n  opacity:.5;\n  margin:28px auto 18px;\n}\n.avd__claim{\n  font-size:clamp(11px, 2.6vw, 14px);\n  font-weight:700;\n  color:#5C3A21;\n  margin:0;\n  white-space:nowrap;\n}\n@media(max-width:640px){\n.avd{\n  padding:40px 18px;\n}\n.avd__eyebrow{\n  margin:28px 0 22px;\n}\n.avd__logos{\n  gap:22px 28px;\n}\n.avd__logo img{\n  height:24px;\n}\n}\n</style>",
