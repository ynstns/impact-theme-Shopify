adding:52px 18px 32px}.anet__divider{margin-top:22px}}\n</style>\n\n<section class=\"aavis2\">\n  <div class=\"aavis2__wrap\">\n    <span class=\"aavis2__eyebrow\">Avis clients</span>\n    <h2 class=\"aavis2__title\">Le plaisir d'un pain <em>frais plus longtemps</em></h2>\n    <p class=\"aavis2__sub\">+ de 12 500 foyers utilisent déjà Maison Auralis au quotidien.</p>\n  </div>\n  <div class=\"aavis2__grid\">\n    <div class=\"aavis2__card\">\n      <div class=\"aavis2__head\">\n        <img class=\"aavis2__avatar\" src=\"https://cdn.shopify.com/s/files/1/0941/4010/5040/files/IMG_5026.jpg?v=1788614863&width=100\" alt=\"Marc D.\" loading=\"lazy\">\n        <div>\n          <span class=\"aavis2__stars\">★★★★★</span>\n          <p class=\"aavis2__name\">Marc D., 58 ans</p>\n        </div>\n      </div>\n      <p class=\"aavis2__badge\">Avis vérifié</p>\n      <p class=\"aavis2__quote\">« Vraiment bluffé par la qualité. Mon pain reste bon plusieurs jours de plus qu'avant, sans effort. »</p>\n    </div>\n    <div class=\"aavis2__card\">\n      <div class=\"aavis2__head\">\n        <img class=\"aavis2__avatar\" src=\"https://cdn.shopify.com/s/files/1/0941/4010/5040/files/IMG_5027.jpg?v=1788614864&width=100\" alt=\"Élise\" loading=\"lazy\">\n        <div>\n          <span class=\"aavis2__stars\">★★★★★</span>\n          <p class=\"aavis2__name\">Élise, 61 ans</p>\n        </div>\n      </div>\n      <p class=\"aavis2__badge\">Avis vérifié</p>\n      <p class=\"aavis2__quote\">« Je pensais que ce serait contraignant à nettoyer. Un simple rinçage suffit, et six mois après il est toujours nickel. »</p>\n    </div>\n    <div class=\"aavis2__card\">\n      <div class=\"aavis2__head\">\n        <img class=\"aavis2__avatar\" src=\"https://cdn.shopify.com/s/files/1/0941/4010/5040/files/IMG_5028.jpg?v=1788614864&width=100\" alt=\"Nicolas\" loading=\"lazy\">\n        <div>\n          <span class=\"aavis2__stars\">★★★★★</span>\n          <p class=\"aavis2__name\">Nicolas, 45 ans</p>\n        </div>\n      </div>\n      <p class=\"aavis2__badge\">Avis vérifié</p>\n      <p class=\"aavis2__quote\">« Le petit plaisir de retrouver une croûte encore croustillante plusieurs jours après l'achat. On ne jette plus rien. »</p>\n    </div>\n  </div>\n</section>\n<style>\n.aavis2{font-family:'Inter',sans-serif;background:transparent;padding:64px 0 72px}\n.aavis2__wrap{max-width:760px;margin:0 auto;padding:0 20px;text-align:center}\n.aavis2__eyebrow{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#C68B3D;margin-bottom:14px}\n.aavis2__title{font-family:'Playfair Display',serif !important;font-size:clamp(24px, 3.8vw, 44px);font-weight:700;color:#2B2118;letter-spacing:-.01em;margin:0 0 12px}\n.aavis2__title em{font-style:italic;font-weight:700;color:#C68B3D}\n.aavis2__sub{font-size:14px;color:#5C3A21;opacity:.8;margin:0}\n.aavis2__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:1100px;margin:44px auto 0;padding:0 20px}\n.aavis2__card{background:#fff;border:1px solid #E7DCC9;border-radius:14px;padding:24px;box-shadow:0 4px 14px rgba(43,33,24,.06)}\n.aavis2__head{display:flex;align-items:center;gap:12px;margin-bottom:14px}\n.aavis2__avatar{width:44px;height:44px;border-radius:50%;object-fit:cover;flex-shrink:0}\n.aavis2__stars{color:#C68B3D;font-size:13px;letter-spacing:1px;display:block}\n.aavis2__name{font-size:14px;font-weight:700;color:#2B2118;margin:2px 0 0}\n.aavis2__badge{font-size:12.5px;font-weight:700;color:#2B2118;margin:0 0 8px}\n.aavis2__quote{font-size:14px;line-height:1.6;color:#4A4137;margin:0}\n@media(max-width:820px){.aavis2__grid{display:flex;grid-template-columns:none;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:0 20px 6px}.aavis2__grid::-webkit-scrollbar{display:none}.aavis2__card{flex:0 0 82%;scroll-snap-align:start}}\n@media(max-width:520px){.aavis2__card{flex:0 0 86%}}\n</style>",
