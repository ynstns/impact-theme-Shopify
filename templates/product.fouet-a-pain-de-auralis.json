        "liquid": "{% comment %} AURALIS — Tableau comparatif — Sac à Pain en Cire d'Abeille {% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,700;1,600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .aur-comp {\n    font-family: 'Poppins', sans-serif;\n    color: #1A1A1A;\n    max-width: 680px;\n    margin: 0 auto;\n    padding: 48px 20px 60px;\n    background: #FFFFFF;\n  }\n\n  .aur-comp__head {\n    text-align: center;\n    margin-bottom: 40px;\n  }\n  .aur-comp__eyebrow {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    margin-bottom: 16px;\n  }\n  .aur-comp__eyebrow::before,\n  .aur-comp__eyebrow::after {\n    content: '';\n    height: 1px;\n    width: 40px;\n    background: #C68B3D;\n    opacity: 0.5;\n  }\n  .aur-comp__title {\n    font-family: 'Playfair Display', serif;\n    font-size: clamp(24px, 5vw, 38px);\n    font-weight: 700;\n    line-height: 1.15;\n    margin: 0 0 12px;\n    color: #1A1A1A;\n    letter-spacing: -0.02em;\n  }\n  .aur-comp__title em {\n    display: block;\n    font-style: italic;\n    font-weight: 600;\n    color: #C68B3D;\n  }\n  .aur-comp__subtitle {\n    font-size: 13.5px;\n    color: #8A8178;\n    line-height: 1.6;\n    max-width: 420px;\n    margin: 0 auto;\n  }\n\n  .aur-comp__hero-img {\n    display: block;\n    max-width: 100%;\n    height: auto;\n    margin: 0 auto 8px;\n    border-radius: 16px;\n  }\n\n  /* Sur ordinateur : l'image sort du conteneur pour s'afficher en grand */\n  @media (min-width: 768px) {\n    .aur-comp__hero-img {\n      max-width: none;\n      width: 100vw;\n      position: relative;\n      left: 50%;\n      right: 50%;\n      margin-left: -50vw;\n      margin-right: -50vw;\n      border-radius: 0;\n    }\n  }\n\n  .aur-comp__table {\n    width: 100%;\n    border-collapse: separate;\n    border-spacing: 0;\n    margin-top: 32px;\n  }\n\n  .aur-comp__table thead tr th {\n    padding: 0;\n    vertical-align: bottom;\n  }\n  .aur-comp__table thead tr th:first-child { width: 52%; }\n  .aur-comp__table thead tr th:not(:first-child) {\n    width: 24%;\n    text-align: center;\n    padding-bottom: 0;\n  }\n\n  .aur-comp__col-wrap {\n    position: relative;\n    padding: 20px 12px 16px;\n    border-radius: 18px 18px 0 0;\n  }\n  .aur-comp__col-wrap--auralis {\n    background: #FBF3E6;\n    border: 1.5px solid rgba(198,139,61,0.3);\n    border-bottom: none;\n  }\n  .aur-comp__col-wrap--other {\n    background: transparent;\n    border: none;\n  }\n\n  .aur-comp__badge {\n    position: absolute;\n    top: -13px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: #C68B3D;\n    color: #FFFFFF;\n    font-size: 8.5px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    padding: 4px 12px;\n    border-radius: 50px;\n    white-space: nowrap;\n    box-shadow: 0 4px 12px rgba(198,139,61,0.35);\n  }\n\n  .aur-comp__col-img {\n    width: 72px;\n    height: 72px;\n    object-fit: contain;\n    display: block;\n    margin: 10px auto 12px;\n    filter: drop-shadow(0 8px 16px rgba(26,26,26,0.12));\n  }\n\n  .aur-comp__col-img-placeholder {\n    width: 56px;\n    height: 56px;\n    margin: 10px auto 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 30px;\n    background: #F0E6D6;\n    border-radius: 50%;\n  }\n\n  .aur-comp__col-name {\n    font-size: 13px;\n    font-weight: 700;\n    text-align: center;\n    margin: 0;\n    letter-spacing: 0.04em;\n  }\n  .aur-comp__col-name--auralis { color: #C68B3D; }\n  .aur-comp__col-name--other { color: #B0A090; }\n\n  .aur-comp__table tbody tr td {\n    padding: 14px 10px;\n    border-bottom: 1px solid rgba(26,26,26,0.06);\n    vertical-align: middle;\n  }\n  .aur-comp__table tbody tr:last-child td {\n    border-bottom: none;\n  }\n  .aur-comp__table tbody tr td:first-child {\n    font-size: 13.5px;\n    font-weight: 400;\n    color: #2A2420;\n    padding-left: 4px;\n    line-height: 1.45;\n  }\n  .aur-comp__table tbody tr td:not(:first-child) { text-align: center; }\n\n  .aur-comp__td--auralis {\n    background: #FBF3E6;\n    border-left: 1.5px solid rgba(198,139,61,0.3);\n    border-right: 1.5px solid rgba(198,139,61,0.3);\n    position: relative;\n  }\n\n  .aur-comp__table tbody tr:last-child td.aur-comp__td--auralis {\n    border-bottom: 1.5px solid rgba(198,139,61,0.3);\n    border-radius: 0 0 18px 18px;\n  }\n\n  .aur-comp__table tbody tr:nth-child(even) td:first-child {\n    background: rgba(92,58,33,0.05);\n  }\n  .aur-comp__table tbody tr:nth-child(even) td.aur-comp__td--auralis {\n    background: rgba(92,58,33,0.08);\n  }\n\n  .aur-comp__check {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: #5C3A21;\n    box-shadow: 0 3px 10px rgba(92,58,33,0.28);\n  }\n  .aur-comp__check svg {\n    width: 15px; height: 15px;\n    stroke: #FFFFFF; fill: none;\n    stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;\n  }\n\n  .aur-comp__cross {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 34px;\n    height: 34px;\n    border-radius: 50%;\n    background: #F0E6D6;\n  }\n  .aur-comp__cross svg {\n    width: 13px; height: 13px;\n    stroke: #C4A876; fill: none;\n    stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round;\n  }\n\n  .aur-comp__feat {\n    display: inline-block;\n    font-size: 9px;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #5C3A21;\n    background: rgba(198,139,61,0.14);\n    border-radius: 4px;\n    padding: 2px 6px;\n    margin-left: 6px;\n    vertical-align: middle;\n  }\n\n  @media (max-width: 480px) {\n    .aur-comp { padding: 32px 14px 40px; }\n    .aur-comp__table tbody tr td:first-child { font-size: 12.5px; }\n    .aur-comp__col-name { font-size: 12px; }\n    .aur-comp__check, .aur-comp__cross { width: 30px; height: 30px; }\n    .aur-comp__col-img { width: 58px; height: 58px; }\n    .aur-comp__feat { display: none; }\n  }\n</style>\n\n<div class=\"aur-comp\">\n\n  <div class=\"aur-comp__head\">\n    <p class=\"aur-comp__eyebrow\">Faites le bon choix</p>\n    <h2 class=\"aur-comp__title\">Comparez par vous-même.<br><em>La différence est évidente.</em></h2>\n  </div>\n\n  <img\n    class=\"aur-comp__hero-img\"\n    src=\"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/ChatGPT_Image_28_juil._2026_02_35_11.png?v=1789762341\"\n    alt=\"Sac à pain en cire d'abeille Maison Auralis\"\n  >",
