26px,4.2vw,34px);line-height:1.15;color:#2B1D12;margin:0 0 10px;font-weight:500}\n.pd-h mark{background:linear-gradient(transparent 55%,#F2DFB4 55%);color:inherit;padding:0 2px}\n.pd-sub{font-family:'Lora',Georgia,serif;font-style:italic;font-size:17px;color:#5C3A21;margin:0 0 20px}\n.pd-list{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:14px}\n.pd-list li{display:flex;gap:14px;align-items:flex-start;font-size:15px;line-height:1.45}\n.pd-ico{flex:none;width:38px;height:38px;border-radius:50%;background:#F6E7C8;border:1px solid #E8D3A3;display:grid;place-items:center}\n.pd-ico svg{width:18px;height:18px;fill:none;stroke:#A9732A;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}\n.pd-warn{border:1.5px dashed #B04A4A;background:#FBEFEF;border-radius:14px;padding:18px 20px;color:#7A1F1F}\n.pd-warn h4{display:flex;align-items:center;gap:10px;margin:0 0 10px;font-size:14px;font-weight:700}\n.pd-warn h4 svg{width:22px;height:22px;fill:none;stroke:#7A1F1F;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}\n.pd-warn p{margin:0;font-size:12.5px;line-height:1.6}\n</style>\n\n<div class=\"pd\">\n  <div class=\"pd-ship\"><span class=\"pd-flag\"><i></i><i></i><i></i></span>Spedizione 24/48h</div>\n\n  {%- if review_count > 0 -%}\n  <div class=\"pd-rate\">\n    <span class=\"pd-stars\"><i style=\"width:{{ rating | divided_by: 5.0 | times: 100 }}%\"></i></span>\n    <b>{{ rating }}/5</b>\n    <span>({{ review_count }} Recensioni)</span>\n  </div>\n  {%- endif -%}\n\n  <div class=\"pd-eye\">Sacchetto per il pane · Formato classico 43 × 33 cm</div>\n  <h2 class=\"pd-h\">Il tuo pane, <mark>conservato con cura</mark></h2>\n  <p class=\"pd-sub\">Il gesto delle nonne, in cotone e cera d'api.</p>\n\n  <ul class=\"pd-list\">\n    <li><span class=\"pd-ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3s6 6.2 6 10.5A6 6 0 0 1 6 13.5C6 9.2 12 3 12 3z\"/></svg></span>\n      <span><b>Cotone e cera d'api naturale</b></span></li>\n    <li><span class=\"pd-ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 19c0-9 6-14 14-14 0 8-5 14-14 14z\"/><path d=\"M5 19l8-8\"/></svg></span>\n      <span><b>Il cotone lascia respirare il pane</b>, la cera rallenta la perdita di umidità</span></li>\n    <li><span class=\"pd-ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 11a8 6 0 0 1 16 0v7H4z\"/><path d=\"M4 14h16\"/></svg></span>\n      <span><b>Più di un canovaccio:</b> la cera aiuta a trattenere l'umidità della mollica, senza passare dal congelatore</span></li>\n    <li><span class=\"pd-ico\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 10h10\"/></svg></span>\n      <span><b>Formato extra large 43 x 33 cm</b> - perfetto per i formati di pane più grandi</span></li>\n    <li><span class=\"pd-ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 12a8 8 0 0 1 14-5l2-2v6h-6l2-2a5 5 0 1 0 1 5\"/></svg></span>\n      <span><b>Zero plastica,</b> riutilizzabile e lavabile a mano</span></li>\n    <li><span class=\"pd-ico\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3l2.6 5.4 5.9.9-4.3 4.1 1 5.8L12 16.5 6.8 19.2l1-5.8L3.5 9.3l5.9-.9z\"/></svg></span>\n      <span><b>30 giorni per provarlo</b> a casa tua</span></li>\n  </ul>\n\n  <div class=\"pd-warn\">\n    <h4><svg viewBox=\"0 0 24 24\"><path d=\"M12 3L2 21h20z\"/><path d=\"M12 10v5\"/><path d=\"M12 18v.01\"/></svg>Attenzione ai sacchetti di scarsa qualità.</h4>\n    <p>A differenza dei sacchetti usa e getta, il nostro sacchetto è <b>privo di plastica</b>. È realizzato in <b>cera d'api naturale</b> e <b>cotone</b>, per una conservazione semplice, genuina e artigianale. Prima di acquistare, controlla sempre che il rivestimento sia vera cera d'api e non uno strato sintetico.</p>\n  </div>\n</div>"
