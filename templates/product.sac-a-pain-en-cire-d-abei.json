y: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .auralis-hero__stock-track {\n    flex: 1;\n    height: 10px;\n    background: #F3DAD7;\n    border-radius: 20px;\n    overflow: hidden;\n  }\n  .auralis-hero__stock-fill {\n    height: 100%;\n    width: 0;\n    background: linear-gradient(90deg, #9E2A24 0%, #C0392B 100%);\n    border-radius: 20px;\n    transition: width 1.6s cubic-bezier(0.22, 1, 0.36, 1);\n  }\n  .auralis-hero__stock-fill.is-filled { width: 91%; }\n  .auralis-hero__stock-label {\n    font-size: 15px;\n    font-weight: 700;\n    color: #C0392B;\n    white-space: nowrap;\n    flex-shrink: 0;\n    letter-spacing: -0.01em;\n  }\n  .auralis-hero__stock-label span {\n    font-size: 10px;\n    font-weight: 600;\n    color: #8A8178;\n    letter-spacing: 0.08em;\n    margin-left: 3px;\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .auralis-hero__stock-fill { transition: none; }\n  }\n</style>\n\n<div class=\"auralis-hero\">\n\n  <!-- TRUST LINE -->\n  <div class=\"auralis-hero__trust\">\n    <span class=\"auralis-hero__tp-stars\">\n      <span class=\"auralis-hero__tp-star\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg></span>\n      <span class=\"auralis-hero__tp-star\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg></span>\n      <span class=\"auralis-hero__tp-star\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg></span>\n      <span class=\"auralis-hero__tp-star\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg></span>\n      <span class=\"auralis-hero__tp-star\"><svg viewBox=\"0 0 24 24\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg></span>\n    </span>\n    <span class=\"auralis-hero__trust-text\">Excellent 4.9 · +11 500 foyers conquis</span>\n    <span class=\"auralis-hero__tp-logo\">\n      <svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n    </span>\n  </div>\n\n  <!-- EYEBROW -->\n  <p class=\"auralis-hero__eyebrow\">🇫🇷 Marque française · fabriqué avec soin</p>\n\n  <!-- TITRE -->\n  <h2 class=\"auralis-hero__title\">Un pain frais plus longtemps, <em>sans plastique autour.</em></h2>\n  <div class=\"auralis-hero__divider\"></div>\n\n  <!-- DESC -->\n  <p class=\"auralis-hero__desc\">\n    Un sac en <strong>coton bio et cire d'abeille</strong>, pensé et fabriqué en France, qui garde votre pain frais plusieurs jours de plus — <em>sans plastique, réutilisable à l'infini.</em>\n  </p>\n\n  <!-- BENEFITS -->\n  <div class=\"auralis-hero__benefits\">\n\n    <div class=\"auralis-hero__benefit\">\n      <div class=\"auralis-hero__benefit-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"/></svg>\n      </div>\n      <div class=\"auralis-hero__benefit-body\">\n        <p class=\"auralis-hero__benefit-title\">Fraîcheur prolongée</p>\n        <p class=\"auralis-hero__benefit-text\">Le pain reste frais jusqu'à 5 jours</p>\n      </div>\n    </div>\n\n    <div class=\"auralis-hero__benefit\">\n      <div class=\"auralis-hero__benefit-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\n      </div>\n      <div class=\"auralis-hero__benefit-body\">\n        <p class=\"auralis-hero__benefit-title\">Barrière naturelle</p>\n        <p class=\"auralis-hero__benefit-text\">La cire d'abeille limite les moisissures</p>\n      </div>\n    </div>\n\n    <div class=\"auralis-hero__benefit\">\n      <div class=\"auralis-hero__benefit-icon\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n      </div>\n      <div class=\"auralis-hero__benefit-body\">\n        <p class=\"auralis-hero__benefit-title\">Zéro plastique</p>\n        <p class=\"auralis-hero__benefit-text\">Coton et cire d'abeille, 100% naturels</p>\n      </div>\n    </div>\n\n    <div class=\"auralis-hero__benefit\">\n      <div class=\"auralis-hero__benefit-icon\">\n        <svg viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg>\n      </div>\n      <div class=\"auralis-hero__benefit-body\">\n        <p class=\"auralis-hero__benefit-title\">Réutilisable</p>\n        <p class=\"auralis-hero__benefit-text\">Lavable et durable pendant des années</p>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- STOCK BAR -->\n  <div class=\"auralis-hero__stock\">\n    <div class=\"auralis-hero__stock-track\">\n      <div class=\"auralis-hero__stock-fill\" id=\"auralisHeroStockFill\"></div>\n    </div>\n    <span class=\"auralis-hero__stock-label\">91% <span>VENDU</span></span>\n  </div>\n\n</div>\n\n<script>\n  (function() {\n    var fill = document.getElementById('auralisHeroStockFill');\n    if (!fill) return;\n    function go() { fill.classList.add('is-filled'); }\n    if ('IntersectionObserver' in window) {\n      var obs = new IntersectionObserver(function(entries) {\n        entries.forEach(function(e) {\n          if (e.isIntersecting) { go(); obs.disconnect(); }\n        });\n      }, { threshold: 0.4 });\n      obs.observe(fill);\n    } else { setTimeout(go, 300); }\n  })();\n</script>"
