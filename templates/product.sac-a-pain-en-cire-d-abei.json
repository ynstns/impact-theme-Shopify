r-comp__table {\n    width: 100%;\n    border-collapse: separate;\n    border-spacing: 0;\n    margin-top: 32px;\n  }\n\n  .aur-comp__table thead tr th {\n    padding: 0;\n    vertical-align: bottom;\n  }\n  .aur-comp__table thead tr th:first-child { width: 52%; }\n  .aur-comp__table thead tr th:not(:first-child) {\n    width: 24%;\n    text-align: center;\n    padding-bottom: 0;\n  }\n\n  .aur-comp__col-wrap {\n    position: relative;\n    padding: 20px 12px 16px;\n    border-radius: 18px 18px 0 0;\n  }\n  .aur-comp__col-wrap--auralis {\n    background: #FBF3E6;\n    border: 1.5px solid rgba(198,139,61,0.3);\n    border-bottom: none;\n  }\n  .aur-comp__col-wrap--other {\n    background: transparent;\n    border: none;\n  }\n\n  .aur-comp__badge {\n    position: absolute;\n    top: -13px;\n    left: 50%;\n    transform: translateX(-50%);\n    background: #C68B3D;\n    color: #FFFFFF;\n    font-size: 8.5px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    padding: 4px 12px;\n    border-radius: 50px;\n    white-space: nowrap;\n    box-shadow: 0 4px 12px rgba(198,139,61,0.35);\n  }\n\n  .aur-comp__col-img {\n    width: 72px;\n    height: 72px;\n    object-fit: contain;\n    display: block;\n    margin: 10px auto 12px;\n    filter: drop-shadow(0 8px 16px rgba(26,26,26,0.12));\n  }\n\n  .aur-comp__col-img-placeholder {\n    width: 56px;\n    height: 56px;\n    margin: 10px auto 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 30px;\n    background: #F0E6D6;\n    border-radius: 50%;\n  }\n\n  .aur-comp__col-name {\n    font-size: 13px;\n    font-weight: 700;\n    text-align: center;\n    margin: 0;\n    letter-spacing: 0.04em;\n  }\n  .aur-comp__col-name--auralis { color: #C68B3D; }\n  .aur-comp__col-name--other { color: #B0A090; }\n\n  .aur-comp__table tbody tr td {\n    padding: 14px 10px;\n    border-bottom: 1px solid rgba(26,26,26,0.06);\n    vertical-align: middle;\n  }\n  .aur-c