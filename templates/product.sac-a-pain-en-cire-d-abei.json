        "liquid": "{{ 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Inter:wght@300;400;500;600;700&display=swap' | stylesheet_tag }}\n\n<section class=\"aavis\">\n  <div class=\"aavis__wrap\">\n    <span class=\"aavis__eyebrow\"><i></i>ILS ONT ADOPTÉ AURALIS<i></i></span>\n    <h2 class=\"aavis__title\">DES CLIENTS CONQUIS, UN PAIN PRÉSERVÉ.</h2>\n    <div class=\"aavis__score\">\n      <span class=\"aavis__score-num\">4.9</span>\n      <span class=\"aavis__stars\">★★★★★</span>\n      <span class=\"aavis__score-sub\">Basée sur +12.500 avis vérifiés</span>\n    </div>\n  </div>\n\n  <div class=\"aavis__slider\">\n    <button class=\"aavis__arrow aavis__arrow--prev\" id=\"aavisPrev\" aria-label=\"Précédent\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"15 18 9 12 15 6\"></polyline></svg>\n    </button>\n\n    <div class=\"aavis__track\" id=\"aavisTrack\">\n      <div class=\"aavis__track-inner\">\n\n        <article class=\"aavis__card\">\n          <div class=\"aavis__photo\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0941/4010/5040/files/1cb01a94-5f20-4725-9ff4-a310b07c0610.png?v=1785466408&width=800&format=webp\" alt=\"Camille avec son sac à pain Maison Auralis\" loading=\"lazy\">\n          </div>\n          <div class=\"aavis__body\">\n            <div class=\"aavis__head\">\n              <span class=\"aavis__name\">Camille D.</span>\n              <span class=\"aavis__stars aavis__stars--sm\">★★★★★</span>\n            </div>\n            <p class=\"aavis__quote\">« Avec trois pains différents à la maison, ils finissaient toujours par sécher trop vite. Ce sac les garde frais plus longtemps, préserve leur goût et nous permet d'en jeter beaucoup moins. »</p>\n            <p class=\"aavis__meta\">47 ans · Nantes</p>\n            <p class=\"aavis__badge\"><span>✓</span> Cliente vérifiée</p>\n          </div>\n        </article>\n\n        <article class=\"aavis__card\">\n          <div class=\"aavis__photo\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0941/4010/5040/files/ChatGPT_Image_28_juil._2026_20_22_41.png?v=1785466330&width=800&format=webp\" alt=\"Marc avec son sac à pain Maison Auralis\" loading=\"lazy\">\n          </div>\n          <div class=\"aavis__body\">\n            <div class=\"aavis__head\">\n              <span class=\"aavis__name\">Marc P.</span>\n              <span class=\"aavis__stars aavis__stars--sm\">★★★★★</span>\n            </div>\n            <p class=\"aavis__quote\">« Depuis que j'utilise ce sac, notre pain reste frais plusieurs jours, la mie garde son moelleux et on en jette beaucoup moins. Je le garde même en voiture au retour de la boulangerie. »</p>\n            <p class=\"aavis__meta\">54 ans · Périgueux</p>\n            <p class=\"aavis__badge\"><span>✓</span> Client vérifié</p>\n          </div>\n        </article>\n\n        <article class=\"aavis__card\">\n          <div class=\"aavis__photo\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0941/4010/5040/files/efd591b9-6d0d-4854-b9cd-fb3b25d9c74b.png?v=1785466358&width=800&format=webp\" alt=\"Isabelle et sa fille avec leur sac à pain Maison Auralis\" loading=\"lazy\">\n          </div>\n          <div class=\"aavis__body\">\n            <div class=\"aavis__head\">\n              <span class=\"aavis__name\">Isabelle R.</span>\n              <span class=\"aavis__stars aavis__stars--sm\">★★★★★</span>\n            </div>\n            <p class=\"aavis__quote\">« Je l'utilise tous les jours et la différence est réelle. Mon pain reste moelleux plus longtemps, la croûte ne ramollit pas et ma fille pioche encore une part croustillante plusieurs jours après. »</p>\n            <p class=\"aavis__meta\">45 ans · Lyon</p>\n            <p class=\"aavis__badge\"><span>✓</span> Cliente vérifiée</p>\n          </div>\n        </article>\n\n      </div>\n    </div>\n\n    <button class=\"aavis__arrow aavis__arrow--next\" id=\"aavisNext\" aria-label=\"Suivant\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg>\n    </button>\n  </div>\n</section>\n\n<style>\n.aavis{ font-family:'Inter',sans-serif; background:#ffffff; padding:64px 0 72px; }\n.aavis__wrap{ max-width:1000px; margin:0 auto; padding:0 20px; text-align:center; }\n\n.aavis__eyebrow{ display:inline-flex; align-items:center; gap:14px; font-size:11px; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:#C68B3D; margin-bottom:18px; }\n.aavis__eyebrow i{ display:block; width:44px; height:1px; background:#C68B3D; opacity:.55; }\n\n.aavis__title{ font-family:'Playfair Display',serif !important; font-weight:700; font-size:clamp(24px, 4.4vw, 40px); color:#2B2118; letter-spacing:-.01em; line-height:1.2; margin:0 0 22px; }\n\n.aavis__score{ display:flex; align-items:center; justify-content:center; gap:14px; flex-wrap:nowrap; white-space:nowrap; }\n.aavis__score-num{ font-family:'Playfair Display',serif; font-size:clamp(26px, 5.5vw, 38px); font-weight:800; color:#2B2118; line-height:1; flex-shrink:0; }\n.aavis__stars{ color:#E0A12B; font-size:clamp(13px, 3.4vw, 17px); letter-spacing:3px; flex-shrink:0; }\n.aavis__score-sub{ font-size:clamp(11px, 2.6vw, 15px); font-weight:600; color:#2B2118; flex-shrink:1; min-width:0; }\n\n/* ── Slider ── */\n.aavis__slider{ position:relative; max-width:1380px; margin:46px auto 0; padding:0 64px; }\n\n.aavis__track{ overflow-x:auto; overflow-y:hidden; -webkit-overflow-scrolling:touch; scroll-snap-type:x mandatory; scroll-behavior:smooth; scrollbar-width:none; }\n.aavis__track::-webkit-scrollbar{ display:none; }\n.aavis__track-inner{ display:flex; gap:24px; width:max-content; padding:4px; }\n\n.aavis__card{ flex:0 0 420px; scroll-snap-align:start; background:#fff; border:1px solid #E7DCC9; border-radius:14px; overflow:hidden; box-shadow:0 2px 10px rgba(43,33,24,.05); display:flex; flex-direction:column; }\n.aavis__photo{ width:100%; aspect-ratio:16/15; background:#F4EEE4; }\n.aavis__photo img{ display:block; width:100%; height:100%; object-fit:cover; }\n\n.aavis__body{ padding:18px 20px 20px; }\n.aavis__head{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:10px; }\n.aavis__name{ font-size:15px; font-weight:700; color:#2B2118; }\n.aavis__stars--sm{ font-size:13px; letter-spacing:1.5px; }\n\n.aavis__quote{ font-size:14.5px; line-height:1.6; color:#4A4038; margin:0 0 14px; }\n.aavis__meta{ font-size:14px; color:#2B2118; margin:0 0 8px; }\n.aavis__badge{ font-size:13.5px; font-weight:500; color:#1E7A46; margin:0; display:flex; align-items:center; gap:6px; }\n.aavis__badge span{ font-weight:700; }\n\n/* ── Flèches ── */\n.aavis__arrow{ position:absolute; top:42%; transform:translateY(-50%); width:44px; height:44px; border-radius:50%; background:#fff; border:1px solid #E7DCC9; color:#2B2118; display:flex; align-items:center; justify-content:center; cursor:pointer; box-shadow:0 2px 10px rgba(43,33,24,.08); transition:background .2s, transform .2s; z-index:2; }\n.aavis__arrow svg{ width:20px; height:20px; }\n.aavis__arrow:hover{ background:#FAF6EF; }\n.aavis__arrow--prev{ left:8px; }\n.aavis__arrow--next{ right:8px; }\n\n@media(max-width:1100px){\n  .aavis__card{ flex:0 0 360px; }\n}\n@media(max-width:768px){\n  .aavis__slider{ padding:0 20px; }\n  .aavis__arrow{ display:none; }\n  .aavis__card{ flex:0 0 84vw; }\n  .aavis__title{ font-size:24px; }\n}\n</style>\n\n<script>\n(function(){\n  var track = document.getElementById('aavisTrack');\n  var prev  = document.getElementById('aavisPrev');\n  var next  = document.getElementById('aavisNext');\n  if(!track) return;\n  function step(){\n    var card = track.querySelector('.aavis__card');\n    return card ? card.getBoundingClientRect().width + 24 : 400;\n  }\n  if(prev) prev.addEventListener('click', function(){ track.scrollBy({ left: -step(), behavior:'smooth' }); });\n  if(next) next.addEventListener('click', function(){ track.scrollBy({ left:  step(), behavior:'smooth' }); });\n})();\n</script>",
