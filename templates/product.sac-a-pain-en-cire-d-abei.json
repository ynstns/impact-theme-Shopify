          "settings": {
            "liquid": "{%- comment -%}\n  RÉGLAGES : mets tes vrais délais d'expédition (jours ouvrés)\n{%- endcomment -%}\n{%- assign min_days = 1 -%}\n{%- assign max_days = 2 -%}\n{%- assign free_shipping = true -%}\n\n<style>\n.dl{font-family:'Poppins',system-ui,sans-serif;color:#2B1D12;max-width:560px;margin-top:16px}\n.dl-box{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid #E7DCC8;border-radius:12px;padding:14px 16px}\n.dl-flag{font-size:30px;line-height:1}\n.dl-l1{display:flex;flex-wrap:wrap;gap:6px 16px;font-weight:600;font-size:14px}\n.dl-l1 span:before{content:\"✓\";color:#1E8A4C;margin-right:6px;font-weight:700}\n.dl-l2{font-size:13px;color:#5C4A3A;margin-top:4px}\n.dl-l2 b{color:#1E8A4C}\n.dl-pay{display:flex;flex-wrap:wrap;justify-content:center;gap:6px;margin:16px 0 8px}\n.dl-pay svg{height:26px;width:auto}\n.dl-ssl{display:flex;align-items:center;justify-content:center;gap:6px;font-size:13px;color:#8a6a2f;margin-bottom:18px}\n.dl-ssl svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}\n.dl-tr{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;text-align:center}\n.dl-tr div{font-size:13px;font-weight:600;line-height:1.3}\n.dl-tr svg{width:42px;height:42px;display:block;margin:0 auto 8px;fill:none;stroke:#8B7355;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n@media(max-width:749px){.dl-tr div{font-size:12px}.dl-l1{font-size:13px}}\n</style>\n\n<div class=\"dl\">\n  <div class=\"dl-box\">\n    <div class=\"dl-flag\">🇮🇹</div>\n    <div>\n      <div class=\"dl-l1\"><span>In tutta Italia</span><span>Spedizione 24/48h</span></div>\n      <div class=\"dl-l2\">Spedizione stimata: <b id=\"dlDates\">…</b></div>\n    </div>\n  </div>\n\n  <div class=\"dl-pay\">\n    {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'dl-pi' }}{%- endfor -%}\n  </div>\n  <div class=\"dl-ssl\">\n    <svg viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"11\" width=\"16\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/></svg>\n    Pagamenti sicuri con crittografia SSL\n  </div>\n\n  <div class=\"dl-tr\">\n    {%- if free_shipping -%}\n    <div>\n      <svg viewBox=\"0 0 48 48\"><path d=\"M3 10h27v22H3z\"/><path d=\"M30 17h8l7 8v7H30z\"/><circle cx=\"11\" cy=\"35\" r=\"4\"/><circle cx=\"37\" cy=\"35\" r=\"4\"/></svg>\n      Spedizione<br>gratuita\n    </div>\n    {%- endif -%}\n    <div>\n      <svg viewBox=\"0 0 48 48\"><path d=\"M10 24a14 14 0 1 1 4 10\"/><path d=\"M10 38v-6h6\"/><text x=\"24\" y=\"29\" text-anchor=\"middle\" font-size=\"13\" font-weight=\"700\" fill=\"#8B7355\" stroke=\"none\">30</text></svg>\n      Reso entro<br>30 giorni\n    </div>\n    <div>\n      <svg viewBox=\"0 0 48 48\"><circle cx=\"24\" cy=\"24\" r=\"18\"/><circle cx=\"18\" cy=\"20\" r=\"1.5\"/><circle cx=\"30\" cy=\"20\" r=\"1.5\"/><path d=\"M16 28c2 4 6 6 8 6s6-2 8-6\"/></svg>\n      Reso facile<br>e veloce\n    </div>\n  </div>\n</div>\n\n<script>\n(function(){\n  var el=document.getElementById('dlDates');if(!el)return;\n  var MIN={{ min_days }},MAX={{ max_days }};\n  var G=['dom','lun','mar','mer','gio','ven','sab'],M=['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic'];\n  function add(n){var d=new Date(),c=0;while(c<n){d.setDate(d.getDate()+1);if(d.getDay()!==0)c++}return d}\n  function f(d){return G[d.getDay()]+' '+d.getDate()+' '+M[d.getMonth()]}\n  el.textContent=f(add(MIN))+' - '+f(add(MAX));\n})();\n</script>"
          }
        }
      },
