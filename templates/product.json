    "custom_liquid_tDbtTJ": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{% comment %} AURALIS — Mécanisme d'action 4 étapes {% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .eli-mec {\n    font-family: 'Poppins', sans-serif;\n    color: #1A1A1A;\n    max-width: 640px;\n    margin: 0 auto;\n    padding: 8px 16px;\n  }\n  .eli-mec__eyebrow-wrap {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    margin-bottom: 14px;\n  }\n  .eli-mec__eyebrow-wrap > span {\n    font-size: 10.5px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    white-space: nowrap;\n  }\n  .eli-mec__eyebrow-line {\n    flex: 1;\n    height: 1px;\n    background: rgba(198,139,61,0.35);\n    max-width: 55px;\n  }\n  .eli-mec__title {\n    text-align: center;\n    font-size: clamp(22px, 5.5vw, 34px);\n    font-weight: 400;\n    line-height: 1.15;\n    letter-spacing: -0.01em;\n    margin: 0 0 6px;\n    color: #1A1A1A;\n  }\n  .eli-mec__title em {\n    display: block;\n    font-style: italic;\n    font-weight: 400;\n    color: #C68B3D;\n  }\n  .eli-mec__subtitle {\n    text-align: center;\n    font-size: 13px;\n    color: #8A7A6A;\n    margin: 0 0 22px;\n  }\n\n  /* STEPS */\n  .eli-mec__steps { display: flex; flex-direction: column; gap: 0; }\n\n  .eli-mec__step {\n    display: grid;\n    grid-template-columns: 100px 1fr;\n    gap: 0;\n    background: #FFFFFF;\n    border: 1px solid rgba(26,26,26,0.08);\n    border-radius: 14px;\n    overflow: hidden;\n    min-height: 105px;\n  }\n\n  .eli-mec__visual {\n    background: #FFFFFF;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 12px 8px 22px;\n    position: relative;\n    flex-shrink: 0;\n  }\n  .eli-mec__visual svg {\n    width: 100%;\n    height: auto;\n    max-width: 84px;\n  }\n  .eli-mec__visual-caption {\n    position: absolute;\n    bottom: 5px;\n    left: 0;\n    right: 0;\n    text-align: center;\n    font-size: 7.5px;\n    color: #A08C7A;\n    padding: 0 4px;\n    letter-spacing: 0.01em;\n    line-height: 1.25;\n  }\n\n  .eli-mec__content {\n    padding: 14px 16px 14px 13px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n  }\n  .eli-mec__step-label {\n    font-size: 9.5px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    margin: 0 0 3px;\n  }\n  .eli-mec__step-title {\n    font-size: clamp(14px, 2.4vw, 17px);\n    font-weight: 600;\n    line-height: 1.2;\n    margin: 0 0 5px;\n    color: #1A1A1A;\n  }\n  .eli-mec__step-text {\n    font-size: 11.5px;\n    line-height: 1.55;\n    color: #4A4640;\n    margin: 0;\n  }\n  .eli-mec__step-text strong { font-weight: 600; color: #5C3A21; }\n\n  .eli-mec__connector {\n    display: flex;\n    justify-content: center;\n    padding: 5px 0;\n  }\n  .eli-mec__connector span {\n    width: 1px;\n    height: 14px;\n    background: #C68B3D;\n    opacity: 0.6;\n    border-radius: 1px;\n  }\n\n  /* ANIMATIONS */\n  @keyframes drift  { 0%,100%{transform:translate(0,0)} 25%{transform:translate(2px,-3px)} 50%{transform:translate(-2px,-5px)} 75%{transform:translate(-3px,-2px)} }\n  @keyframes drift2 { 0%,100%{transform:translate(0,0)} 25%{transform:translate(-2px,-4px)} 50%{transform:translate(3px,-6px)} 75%{transform:translate(2px,-2px)} }\n  @keyframes drift3 { 0%,100%{transform:translate(0,0)} 33%{transform:translate(3px,-4px)} 66%{transform:translate(-2px,-3px)} }\n  @keyframes drift4 { 0%,100%{transform:translate(0,0)} 33%{transform:translate(-3px,-5px)} 66%{transform:translate(2px,-2px)} }\n  @keyframes drift5 { 0%,100%{transform:translate(0,0)} 50%{transform:translate(1px,-4px)} }\n  @keyframes float-up { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }\n  @keyframes spin-float { 0%,100%{transform:translateY(0) rotate(0deg)} 50%{transform:translateY(-3px) rotate(5deg)} }\n  @keyframes appear-dot { 0%,100%{opacity:.3;transform:scale(.7)} 50%{opacity:1;transform:scale(1)} }\n  @keyframes cross-fade { 0%,100%{opacity:1} 50%{opacity:.4} }\n  @keyframes smile-grow { 0%,100%{transform:scaleX(1)} 50%{transform:scaleX(1.15)} }\n  @keyframes bar-grow1 { 0%,100%{transform:scaleY(1)} 50%{transform:scaleY(1.1)} }\n  @keyframes bar-grow2 { 0%,100%{transform:scaleY(1)} 50%{transform:scaleY(1.18)} }\n  @keyframes bar-grow3 { 0%,100%{transform:scaleY(1)} 50%{transform:scaleY(1.3)} }\n\n  .anim-bubble1{animation:drift 3.2s ease-in-out infinite}\n  .anim-bubble2{animation:drift2 2.8s ease-in-out infinite .3s}\n  .anim-bubble3{animation:drift3 3.5s ease-in-out infinite .6s}\n  .anim-bubble4{animation:drift4 2.6s ease-in-out infinite .9s}\n  .anim-bubble5{animation:drift5 3.8s ease-in-out infinite .4s}\n  .anim-arrow{animation:float-up 2.2s ease-in-out infinite}\n  .anim-pill{animation:spin-float 3s ease-in-out infinite}\n  .anim-dot1{animation:appear-dot 2s ease-in-out infinite}\n  .anim-dot2{animation:appear-dot 2s ease-in-out infinite .5s}\n  .anim-dot3{animation:appear-dot 2s ease-in-out infinite 1s}\n  .anim-dot4{animation:appear-dot 2s ease-in-out infinite 1.5s}\n  .anim-cross1{animation:cross-fade 2.4s ease-in-out infinite}\n  .anim-cross2{animation:cross-fade 2.4s ease-in-out infinite .8s}\n  .anim-smile{animation:smile-grow 2.8s ease-in-out infinite;transform-origin:center;transform-box:fill-box}\n  .anim-bar1{animation:bar-grow1 2.5s ease-in-out infinite;transform-origin:bottom;transform-box:fill-box}\n  .anim-bar2{animation:bar-grow2 2.5s ease-in-out infinite .4s;transform-origin:bottom;transform-box:fill-box}\n  .anim-bar3{animation:bar-grow3 2.5s ease-in-out infinite .8s;transform-origin:bottom;transform-box:fill-box}\n\n  @media (max-width: 480px) {\n    .eli-mec__step { grid-template-columns: 82px 1fr; min-height: 95px; }\n    .eli-mec__step-title { font-size: 13.5px; }\n    .eli-mec__step-text { font-size: 11px; }\n    .eli-mec__visual svg { max-width: 70px; }\n  }\n</style>\n\n<div class=\"eli-mec\">\n\n  <div class=\"eli-mec__eyebrow-wrap\">\n    <span class=\"eli-mec__eyebrow-line\"></span>\n    <span>Mécanisme d'action</span>\n    <span class=\"eli-mec__eyebrow-line\"></span>\n  </div>\n\n  <h2 class=\"eli-mec__title\">Comment Auralis <em>protège votre pain.</em></h2>\n  <p class=\"eli-mec__subtitle\">4 étapes. De la cire d'abeille à la fraîcheur retrouvée.</p>\n\n  <div class=\"eli-mec__steps\">\n\n    <!-- ÉTAPE 1 -->\n    <div class=\"eli-mec__step\">\n      <div class=\"eli-mec__visual\">\n        <svg viewBox=\"0 0 100 80\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M28 30 Q28 18 50 18 Q72 18 72 30 L72 62 Q72 70 50 70 Q28 70 28 62 Z\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.8\"/>\n          <ellipse cx=\"50\" cy=\"48\" rx=\"16\" ry=\"10\" fill=\"#F1DDBD\"/>\n          <path d=\"M42 48 Q50 42 58 48\" fill=\"none\" stroke=\"#9C6A2E\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n          <circle class=\"anim-bubble1\" cx=\"38\" cy=\"22\" r=\"2.4\" fill=\"#C68B3D\"/>\n          <circle class=\"anim-bubble2\" cx=\"62\" cy=\"20\" r=\"2\" fill=\"#C68B3D\"/>\n          <circle class=\"anim-bubble3\" cx=\"50\" cy=\"14\" r=\"1.8\" fill=\"#C68B3D\"/>\n        </svg>\n        <span class=\"eli-mec__visual-caption\">Pain glissé dans le sac</span>\n      </div>\n      <div class=\"eli-mec__content\">\n        <p class=\"eli-mec__step-label\">Étape 01</p>\n        <h3 class=\"eli-mec__step-title\">Le pain est placé dans le sac</h3>\n        <p class=\"eli-mec__step-text\">Dès la sortie du four ou de la boulangerie, le pain est glissé dans le sac Auralis, qui <strong>l'enveloppe entièrement</strong>.</p>\n      </div>\n    </div>\n\n    <div class=\"eli-mec__connector\"><span></span></div>\n\n    <!-- ÉTAPE 2 -->\n    <div class=\"eli-mec__step\">\n      <div class=\"eli-mec__visual\">\n        <svg viewBox=\"0 0 100 80\" xmlns=\"http://www.w3.org/2000/svg\">\n          <g class=\"anim-pill\">\n            <rect x=\"30\" y=\"34\" width=\"40\" height=\"16\" rx=\"8\" fill=\"#1A1A1A\"/>\n            <text x=\"50\" y=\"45\" font-family=\"Poppins,sans-serif\" font-size=\"7\" fill=\"#FFFFFF\" text-anchor=\"middle\" font-weight=\"600\">auralis</text>\n          </g>\n          <circle class=\"anim-dot1\" cx=\"18\" cy=\"18\" r=\"3\" fill=\"#C68B3D\"/>\n          <circle class=\"anim-dot2\" cx=\"82\" cy=\"20\" r=\"3\" fill=\"#C68B3D\"/>\n          <circle class=\"anim-dot3\" cx=\"15\" cy=\"62\" r=\"3\" fill=\"#C68B3D\"/>\n          <circle class=\"anim-dot4\" cx=\"85\" cy=\"62\" r=\"3\" fill=\"#C68B3D\"/>\n          <text x=\"18\" y=\"11\" font-family=\"Poppins,sans-serif\" font-size=\"6.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">Cire</text>\n          <text x=\"82\" y=\"13\" font-family=\"Poppins,sans-serif\" font-size=\"6.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">Coton bio</text>\n          <text x=\"15\" y=\"74\" font-family=\"Poppins,sans-serif\" font-size=\"6.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">Résine</text>\n          <text x=\"85\" y=\"74\" font-family=\"Poppins,sans-serif\" font-size=\"6.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">Jojoba</text>\n        </svg>\n        <span class=\"eli-mec__visual-caption\">Barrière cire d'abeille</span>\n      </div>\n      <div class=\"eli-mec__content\">\n        <p class=\"eli-mec__step-label\">Étape 02</p>\n        <h3 class=\"eli-mec__step-title\">La cire d'abeille forme une barrière</h3>\n        <p class=\"eli-mec__step-text\">Cire d'abeille, coton bio et huile naturelle forment une pellicule qui <strong>laisse le pain respirer</strong> tout en le protégeant de l'air.</p>\n      </div>\n    </div>\n\n    <div class=\"eli-mec__connector\"><span></span></div>\n\n    <!-- ÉTAPE 3 -->\n    <div class=\"eli-mec__step\">\n      <div class=\"eli-mec__visual\">\n        <svg viewBox=\"0 0 100 80\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M28 30 Q28 18 50 18 Q72 18 72 30 L72 62 Q72 70 50 70 Q28 70 28 62 Z\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.8\"/>\n          <g class=\"anim-cross1\">\n            <line x1=\"35\" y1=\"28\" x2=\"43\" y2=\"36\" stroke=\"#9E2A24\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n            <line x1=\"43\" y1=\"28\" x2=\"35\" y2=\"36\" stroke=\"#9E2A24\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n          </g>\n          <g class=\"anim-cross2\">\n            <line x1=\"57\" y1=\"26\" x2=\"65\" y2=\"34\" stroke=\"#9E2A24\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n            <line x1=\"65\" y1=\"26\" x2=\"57\" y2=\"34\" stroke=\"#9E2A24\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n          </g>\n          <path class=\"anim-smile\" d=\"M38 56 a12 7 0 0 0 24 0\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\"/>\n        </svg>\n        <span class=\"eli-mec__visual-caption\">Humidité régulée</span>\n      </div>\n      <div class=\"eli-mec__content\">\n        <p class=\"eli-mec__step-label\">Étape 03</p>\n        <h3 class=\"eli-mec__step-title\">L'humidité s'équilibre naturellement</h3>\n        <p class=\"eli-mec__step-text\">La toile cirée laisse circuler l'air : l'humidité en excès s'évacue, <strong>évitant croûte molle et moisissures</strong>, tout en gardant la mie moelleuse.</p>\n      </div>\n    </div>\n\n    <div class=\"eli-mec__connector\"><span></span></div>\n\n    <!-- ÉTAPE 4 -->\n    <div class=\"eli-mec__step\">\n      <div class=\"eli-mec__visual\">\n        <svg viewBox=\"0 0 100 80\" xmlns=\"http://www.w3.org/2000/svg\">\n          <line x1=\"10\" y1=\"66\" x2=\"90\" y2=\"66\" stroke=\"#D9CDBE\" stroke-width=\"1.2\"/>\n          <circle cx=\"22\" cy=\"66\" r=\"2.5\" fill=\"#C68B3D\"/>\n          <g class=\"anim-bar1\">\n            <path d=\"M22 60 Q22 54 28 52\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n          </g>\n          <text x=\"22\" y=\"46\" font-family=\"Poppins,sans-serif\" font-size=\"5.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">Croûte</text>\n          <text x=\"22\" y=\"53\" font-family=\"Poppins,sans-serif\" font-size=\"5.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">croustillante</text>\n          <circle cx=\"52\" cy=\"66\" r=\"2.5\" fill=\"#C68B3D\"/>\n          <g class=\"anim-bar2\">\n            <path d=\"M47 60 Q47 48 52 40\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n            <path d=\"M57 60 Q57 48 52 40\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n          </g>\n          <text x=\"52\" y=\"33\" font-family=\"Poppins,sans-serif\" font-size=\"5.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">Mie</text>\n          <text x=\"52\" y=\"40\" font-family=\"Poppins,sans-serif\" font-size=\"5.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">moelleuse</text>\n          <circle cx=\"80\" cy=\"66\" r=\"2.5\" fill=\"#C68B3D\"/>\n          <g class=\"anim-bar3\">\n            <path d=\"M74 60 Q74 40 80 24\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n            <path d=\"M80 60 Q80 40 80 24\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n            <path d=\"M86 60 Q86 40 80 24\" fill=\"none\" stroke=\"#C68B3D\" stroke-width=\"1.4\" stroke-linecap=\"round\"/>\n          </g>\n          <text x=\"80\" y=\"17\" font-family=\"Poppins,sans-serif\" font-size=\"5.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">Toujours</text>\n          <text x=\"80\" y=\"24\" font-family=\"Poppins,sans-serif\" font-size=\"5.5\" fill=\"#9C6A2E\" text-anchor=\"middle\" font-weight=\"600\">frais</text>\n          <text x=\"22\" y=\"75\" font-family=\"Poppins,sans-serif\" font-size=\"5\" fill=\"#A08C7A\" text-anchor=\"middle\">Jour 1</text>\n          <text x=\"52\" y=\"75\" font-family=\"Poppins,sans-serif\" font-size=\"5\" fill=\"#A08C7A\" text-anchor=\"middle\">Jour 3</text>\n          <text x=\"80\" y=\"75\" font-family=\"Poppins,sans-serif\" font-size=\"5\" fill=\"#A08C7A\" text-anchor=\"middle\">Jour 5</text>\n        </svg>\n        <span class=\"eli-mec__visual-caption\">Évolution de la fraîcheur</span>\n      </div>\n      <div class=\"eli-mec__content\">\n        <p class=\"eli-mec__step-label\">Étape 04</p>\n        <h3 class=\"eli-mec__step-title\">Le pain reste frais jusqu'à 5 jours</h3>\n        <p class=\"eli-mec__step-text\"><strong>Jour 1 :</strong> croûte croustillante. <strong>Jour 3 :</strong> mie encore moelleuse. <strong>Jour 5 :</strong> pain toujours bon, sans sac plastique.</p>\n      </div>\n    </div>\n\n  </div>\n</div>",
