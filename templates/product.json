    "custom_liquid_4nUkGi": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{% comment %} AURALIS — FAQ style Oren {% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .eli-faq {\n    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;\n    max-width: 640px;\n    margin: 0 auto;\n    padding: 8px 16px 40px;\n    color: #1A1A1A;\n  }\n\n  .eli-faq__eyebrow-wrap {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    margin-bottom: 16px;\n  }\n  .eli-faq__eyebrow-wrap > span {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    white-space: nowrap;\n  }\n  .eli-faq__eyebrow-line {\n    flex: 1;\n    height: 1px;\n    background: rgba(198,139,61,0.35);\n    max-width: 60px;\n  }\n\n  .eli-faq__title {\n    text-align: center;\n    font-size: clamp(26px, 6vw, 38px);\n    font-weight: 700;\n    line-height: 1.1;\n    margin: 0 0 4px;\n    color: #1A1A1A;\n  }\n  .eli-faq__title-italic {\n    display: block;\n    font-style: italic;\n    font-weight: 400;\n    color: #C68B3D;\n    font-size: clamp(24px, 5.5vw, 36px);\n  }\n  .eli-faq__subtitle {\n    text-align: center;\n    font-size: 14px;\n    color: #8A7A6A;\n    margin: 0 0 32px;\n  }\n\n  .eli-faq__list {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin-bottom: 28px;\n  }\n\n  .eli-faq__item {\n    border: 1px solid rgba(26,26,26,0.09);\n    border-radius: 16px;\n    background: #FFFFFF;\n    overflow: hidden;\n    transition: border-color 0.25s;\n  }\n  .eli-faq__item.is-open {\n    border-color: rgba(198,139,61,0.35);\n  }\n\n  .eli-faq__question {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 18px 18px 18px 20px;\n    cursor: pointer;\n    user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .eli-faq__question-text {\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1.35;\n    color: #1A1A1A;\n    margin: 0;\n    flex: 1;\n  }\n\n  .eli-faq__chevron {\n    flex-shrink: 0;\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    background: rgba(198,139,61,0.12);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: background 0.25s, transform 0.3s;\n  }\n  .eli-faq__item.is-open .eli-faq__chevron {\n    background: #C68B3D;\n    transform: rotate(180deg);\n  }\n  .eli-faq__chevron svg { width: 14px; height: 14px; }\n  .eli-faq__chevron svg path {\n    stroke: #C68B3D;\n    transition: stroke 0.25s;\n  }\n  .eli-faq__item.is-open .eli-faq__chevron svg path { stroke: #FFFFFF; }\n\n  .eli-faq__answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.35s ease;\n  }\n  .eli-faq__item.is-open .eli-faq__answer { max-height: 600px; }\n  .eli-faq__answer-inner {\n    padding: 14px 20px 20px;\n    font-size: 13.5px;\n    line-height: 1.65;\n    color: #4A4640;\n    border-top: 1px solid rgba(26,26,26,0.06);\n  }\n  .eli-faq__answer-inner strong { font-weight: 600; color: #5C3A21; }\n  .eli-faq__answer-inner .highlight { color: #C68B3D; font-weight: 600; }\n\n  /* CONTACT — fond blanc */\n  .eli-faq__contact {\n    background: #FFFFFF;\n    border: 1px solid rgba(198,139,61,0.25);\n    border-radius: 18px;\n    padding: 28px 20px;\n    text-align: center;\n  }\n  .eli-faq__contact-title {\n    font-size: 18px;\n    font-weight: 700;\n    color: #1A1A1A;\n    margin: 0 0 6px;\n  }\n  .eli-faq__contact-sub {\n    font-size: 13.5px;\n    color: #8A7A6A;\n    margin: 0 0 20px;\n  }\n  .eli-faq__contact-btn {\n    display: inline-block;\n    padding: 13px 36px;\n    border: 1.5px solid #C68B3D;\n    border-radius: 50px;\n    font-family: 'Poppins', sans-serif;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    text-decoration: none;\n    background: transparent;\n    cursor: pointer;\n    transition: background 0.2s, color 0.2s;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .eli-faq__contact-btn:hover {\n    background: #C68B3D;\n    color: #FFFFFF;\n  }\n</style>\n\n<div class=\"eli-faq\">\n\n  <div class=\"eli-faq__eyebrow-wrap\">\n    <span class=\"eli-faq__eyebrow-line\"></span>\n    <span>FAQ</span>\n    <span class=\"eli-faq__eyebrow-line\"></span>\n  </div>\n\n  <h2 class=\"eli-faq__title\">\n    Des questions ?\n    <em class=\"eli-faq__title-italic\">Nous avons les réponses.</em>\n  </h2>\n  <p class=\"eli-faq__subtitle\">Tout ce que vous devez savoir sur votre sac à pain Auralis.</p>\n\n  <div class=\"eli-faq__list\">\n\n    <div class=\"eli-faq__item\">\n      <div class=\"eli-faq__question\">\n        <p class=\"eli-faq__question-text\">Combien de temps mon pain reste-t-il frais avec le sac Auralis ?</p>\n        <span class=\"eli-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 5L7 9L11 5\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n      <div class=\"eli-faq__answer\">\n        <div class=\"eli-faq__answer-inner\">\n          Grâce à la <strong>cire d'abeille naturelle</strong> qui enrobe le tissu, votre pain conserve son croustillant et son moelleux <span class=\"highlight\">jusqu'à 5 jours</span>, contre 1 à 2 jours dans un sac plastique classique.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"eli-faq__item\">\n      <div class=\"eli-faq__question\">\n        <p class=\"eli-faq__question-text\">Comment fonctionne la cire d'abeille pour conserver le pain ?</p>\n        <span class=\"eli-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 5L7 9L11 5\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n      <div class=\"eli-faq__answer\">\n        <div class=\"eli-faq__answer-inner\">\n          La cire crée une <strong>barrière respirante</strong> : elle laisse le pain respirer tout en le protégeant de l'air, ce qui évite qu'il ne durcisse ou ne moisisse trop vite. C'est le même principe que les cures d'antan chez le boulanger.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"eli-faq__item\">\n      <div class=\"eli-faq__question\">\n        <p class=\"eli-faq__question-text\">Comment nettoyer et entretenir mon sac Auralis ?</p>\n        <span class=\"eli-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 5L7 9L11 5\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n      <div class=\"eli-faq__answer\">\n        <div class=\"eli-faq__answer-inner\">\n          Il suffit de le passer à l'<strong>eau froide avec un peu de savon doux</strong>, puis de le laisser sécher à l'air libre. Évitez l'eau chaude et le lave-vaisselle, qui feraient fondre la cire. <span class=\"highlight\">Un simple rinçage suffit la plupart du temps.</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"eli-faq__item\">\n      <div class=\"eli-faq__question\">\n        <p class=\"eli-faq__question-text\">Combien de temps dure un sac avant de devoir le remplacer ?</p>\n        <span class=\"eli-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 5L7 9L11 5\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n      <div class=\"eli-faq__answer\">\n        <div class=\"eli-faq__answer-inner\">\n          Avec un entretien adapté, un sac Auralis dure <span class=\"highlight\">plus d'un an</span> d'utilisation quotidienne. Si la cire s'amenuise avec le temps, il est possible de la raviver légèrement au four à basse température.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"eli-faq__item\">\n      <div class=\"eli-faq__question\">\n        <p class=\"eli-faq__question-text\">Quelle taille de sac dois-je choisir ?</p>\n        <span class=\"eli-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 5L7 9L11 5\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n      <div class=\"eli-faq__answer\">\n        <div class=\"eli-faq__answer-inner\">\n          Notre sac mesure <strong>30 x 40 cm</strong>, une taille pensée pour accueillir la plupart des pains de boulangerie : baguettes, pains de campagne, boules ou pains longs.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"eli-faq__item\">\n      <div class=\"eli-faq__question\">\n        <p class=\"eli-faq__question-text\">Est-ce écologique et sans plastique ?</p>\n        <span class=\"eli-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 5L7 9L11 5\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n      <div class=\"eli-faq__answer\">\n        <div class=\"eli-faq__answer-inner\">\n          <strong>Oui, entièrement.</strong> Le sac Auralis est fabriqué en <span class=\"highlight\">coton bio et cire d'abeille naturelle</span>, sans aucun plastique. Réutilisable à l'infini, il remplace les sacs jetables du quotidien.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"eli-faq__item\">\n      <div class=\"eli-faq__question\">\n        <p class=\"eli-faq__question-text\">Convient-il à tous les types de pain ?</p>\n        <span class=\"eli-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 5L7 9L11 5\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n      <div class=\"eli-faq__answer\">\n        <div class=\"eli-faq__answer-inner\">\n          Le sac Auralis convient à la <span class=\"highlight\">majorité des pains</span> : baguette, pain de campagne, pain complet, brioche. Pour les très grosses pièces, pliez simplement le pain ou repliez l'ouverture du sac.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"eli-faq__item\">\n      <div class=\"eli-faq__question\">\n        <p class=\"eli-faq__question-text\">Le sac contient-il des allergènes ?</p>\n        <span class=\"eli-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M3 5L7 9L11 5\" stroke=\"#C68B3D\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span>\n      </div>\n      <div class=\"eli-faq__answer\">\n        <div class=\"eli-faq__answer-inner\">\n          Le sac contient de la <strong>cire d'abeille naturelle</strong>. Si vous êtes allergique aux produits de la ruche, nous vous conseillons de nous contacter avant votre achat afin d'évoquer les alternatives possibles.\n        </div>\n      </div>\n    </div>\n\n  </div>\n\n  <div class=\"eli-faq__contact\">\n    <p class=\"eli-faq__contact-title\">Une autre question ?</p>\n    <p class=\"eli-faq__contact-sub\">Notre équipe vous répond sous 24h, en français.</p>\n    <a href=\"/pages/contact\" class=\"eli-faq__contact-btn\">Nous écrire</a>\n  </div>\n\n</div>\n\n<script>\n  document.querySelectorAll('.eli-faq__question').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n      var item = btn.closest('.eli-faq__item');\n      var isOpen = item.classList.contains('is-open');\n      document.querySelectorAll('.eli-faq__item.is-open').forEach(function(el) {\n        el.classList.remove('is-open');\n      });\n      if (!isOpen) { item.classList.add('is-open'); }\n    });\n  });\n</script>",
