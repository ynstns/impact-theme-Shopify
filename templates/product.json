        "remove_horizontal_spacing": false,
        "liquid": "<link href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,500&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .eli-ing {\n    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;\n    color: #1A1A1A;\n    max-width: 580px;\n    margin: 0 auto;\n    padding: 6px 4px;\n  }\n\n  /* ── HEADER ── */\n  .eli-ing__header {\n    text-align: center;\n    margin-bottom: 24px;\n    padding: 0 12px;\n  }\n  .eli-ing__header-eyebrow {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.20em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    margin: 0 0 12px;\n  }\n  .eli-ing__header-eyebrow::before,\n  .eli-ing__header-eyebrow::after {\n    content: '';\n    display: block;\n    width: 32px;\n    height: 1px;\n    background: #C68B3D;\n  }\n  .eli-ing__header-title {\n    font-size: clamp(22px, 5.5vw, 32px);\n    font-weight: 400;\n    line-height: 1.15;\n    margin: 0 0 4px;\n    color: #1A1A1A;\n  }\n  .eli-ing__header-title em {\n    font-style: italic;\n    font-weight: 500;\n    color: #C68B3D;\n    display: block;\n  }\n  .eli-ing__header-sub {\n    font-size: 13px;\n    color: #8A7A6A;\n    margin: 8px 0 0;\n    font-weight: 400;\n  }\n\n  .eli-ing__card {\n    background: #FFFFFF;\n    border: 1px solid rgba(26,26,26,0.07);\n    border-radius: 16px;\n    overflow: hidden;\n    box-shadow: 0 4px 16px rgba(26,26,26,0.05);\n    margin-bottom: 18px;\n  }\n  .eli-ing__card:last-child { margin-bottom: 0; }\n\n  .eli-ing__photo {\n    width: 100%;\n    aspect-ratio: 16 / 7;\n    object-fit: cover;\n    display: block;\n    background: #FFFFFF;\n  }\n\n  .eli-ing__body {\n    padding: 16px 18px 18px;\n  }\n\n  .eli-ing__eyebrow {\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    margin: 0 0 5px;\n  }\n\n  .eli-ing__title {\n    font-size: clamp(18px, 4vw, 24px);\n    font-weight: 600;\n    line-height: 1.12;\n    letter-spacing: -0.01em;\n    margin: 0 0 4px;\n    color: #1A1A1A;\n  }\n\n  .eli-ing__subtitle {\n    font-size: 12px;\n    font-style: italic;\n    font-weight: 400;\n    color: #8A7A6A;\n    margin: 0 0 12px;\n  }\n\n  .eli-ing__divider {\n    width: 40px;\n    height: 2px;\n    background: #C68B3D;\n    border-radius: 2px;\n    margin-bottom: 12px;\n  }\n\n  .eli-ing__list {\n    list-style: none;\n    margin: 0 0 14px;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n  .eli-ing__list li {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n    font-size: 13px;\n    line-height: 1.4;\n    color: #4A4640;\n  }\n  .eli-ing__dot {\n    width: 6px;\n    height: 6px;\n    min-width: 6px;\n    border-radius: 50%;\n    background: #C68B3D;\n    margin-top: 6px;\n    flex-shrink: 0;\n  }\n  .eli-ing__list strong {\n    font-weight: 600;\n    color: #1A1A1A;\n  }\n\n  .eli-ing__badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: rgba(198, 139, 61, 0.10);\n    color: #9C6A2E;\n    font-size: 12px;\n    font-weight: 600;\n    padding: 7px 14px;\n    border-radius: 999px;\n  }\n  .eli-ing__badge svg {\n    width: 13px;\n    height: 13px;\n    stroke: #9C6A2E;\n    fill: none;\n    stroke-width: 2.5;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n    flex-shrink: 0;\n  }\n\n  .eli-ing__cta-wrap {\n    text-align: center;\n    margin-top: 24px;\n  }\n  .eli-ing__cta-text {\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.4;\n    color: #1A1A1A;\n    margin: 0 0 16px;\n  }\n  .eli-ing__cta-text em {\n    font-style: italic;\n    font-weight: 500;\n    color: #C68B3D;\n  }\n  .eli-ing__cta-btn {\n    display: inline-block;\n    width: 100%;\n    max-width: 480px;\n    background: #C68B3D;\n    color: #FFFFFF;\n    font-family: 'Poppins', sans-serif;\n    font-size: 16px;\n    font-weight: 700;\n    text-align: center;\n    text-decoration: none;\n    padding: 14px 24px;\n    border: none;\n    border-radius: 999px;\n    cursor: pointer;\n    box-shadow: 0 6px 16px rgba(198, 139, 61, 0.28);\n  }\n  .eli-ing__cta-checks {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 18px;\n    flex-wrap: wrap;\n    margin-top: 12px;\n    font-size: 12px;\n    color: #8A7A6A;\n  }\n  .eli-ing__cta-checks span {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n  }\n  .eli-ing__cta-checks svg {\n    width: 12px;\n    height: 12px;\n    stroke: #C68B3D;\n    fill: none;\n    stroke-width: 3;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  @media (max-width: 600px) {\n    .eli-ing { padding: 4px 2px; }\n    .eli-ing__header { margin-bottom: 18px; }\n    .eli-ing__header-title { font-size: clamp(20px, 6vw, 26px); }\n    .eli-ing__card { border-radius: 12px; margin-bottom: 14px; }\n    .eli-ing__body { padding: 14px 14px 16px; }\n    .eli-ing__title { font-size: clamp(17px, 5.5vw, 22px); }\n    .eli-ing__list { gap: 8px; margin-bottom: 12px; }\n    .eli-ing__list li { font-size: 12.5px; }\n    .eli-ing__badge { font-size: 11.5px; padding: 6px 12px; }\n    .eli-ing__cta-wrap { margin-top: 18px; }\n    .eli-ing__cta-text { font-size: 14px; margin-bottom: 14px; }\n    .eli-ing__cta-btn { font-size: 15px; padding: 13px 20px; }\n  }\n</style>\n\n<div class=\"eli-ing\">\n\n  <!-- HEADER -->\n  <div class=\"eli-ing__header\">\n    <p class=\"eli-ing__header-eyebrow\">Matières Naturelles</p>\n    <h2 class=\"eli-ing__header-title\">\n      Deux matières.\n      <em>Une seule mission.</em>\n    </h2>\n    <p class=\"eli-ing__header-sub\">Deux matières. Zéro plastique. Un seul objectif.</p>\n  </div>\n\n  <!-- Carte 1 : Cire d'Abeille -->\n  <div class=\"eli-ing__card\">\n    <img class=\"eli-ing__photo\" src=\"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/b5691258-0634-43cb-9d58-1edac4782cea.webp?v=1789769323\" alt=\"Cire d'Abeille Naturelle\">\n    <div class=\"eli-ing__body\">\n      <p class=\"eli-ing__eyebrow\">Matière 01</p>\n      <h3 class=\"eli-ing__title\">Cire d'Abeille Naturelle</h3>\n      <p class=\"eli-ing__subtitle\">Cera alba · Couche protectrice enduite sur le tissu</p>\n      <div class=\"eli-ing__divider\"></div>\n      <ul class=\"eli-ing__list\">\n        <li>\n          <span class=\"eli-ing__dot\"></span>\n          <span><strong>Crée une barrière respirante</strong> — protège le pain de l'air tout en le laissant respirer</span>\n        </li>\n        <li>\n          <span class=\"eli-ing__dot\"></span>\n          <span><strong>Prolonge la fraîcheur</strong> — jusqu'à 5 jours, contre 1 à 2 jours en sac plastique</span>\n        </li>\n        <li>\n          <span class=\"eli-ing__dot\"></span>\n          <span><strong>100 % naturelle</strong> — issue d'une apiculture responsable</span>\n        </li>\n      </ul>\n      <span class=\"eli-ing__badge\">\n        <svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n        Utilisée depuis des siècles pour conserver les aliments\n      </span>\n    </div>\n  </div>\n\n  <!-- Carte 2 : Coton Biologique -->\n  <div class=\"eli-ing__card\">\n    <img class=\"eli-ing__photo\" src=\"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/istockphoto-1333742146-612x612_1.webp?v=1789769350\" alt=\"Coton Biologique\">\n    <div class=\"eli-ing__body\">\n      <p class=\"eli-ing__eyebrow\">Matière 02</p>\n      <h3 class=\"eli-ing__title\">Coton Biologique</h3>\n      <p class=\"eli-ing__subtitle\">Coton bio certifié · Tissu résistant et lavable</p>\n      <div class=\"eli-ing__divider\"></div>\n      <ul class=\"eli-ing__list\">\n        <li>\n          <span class=\"eli-ing__dot\"></span>\n          <span><strong>Résistant et durable</strong> — conçu pour un usage quotidien pendant plus d'un an</span>\n        </li>\n        <li>\n          <span class=\"eli-ing__dot\"></span>\n          <span><strong>Lavable à l'eau froide</strong> — s'entretient facilement sans perdre ses propriétés</span>\n        </li>\n        <li>\n          <span class=\"eli-ing__dot\"></span>\n          <span><strong>Sans traitement chimique</strong> — cultivé sans pesticides ni produits toxiques</span>\n        </li>\n      </ul>\n      <span class=\"eli-ing__badge\">\n        <svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n        Certifié agriculture biologique\n      </span>\n    </div>\n  </div>\n\n  <!-- CTA -->\n  <div class=\"eli-ing__cta-wrap\">\n    <p class=\"eli-ing__cta-text\">Deux matières. Un sac. <em>Un pain frais plus longtemps.</em></p>\n    <a href=\"https://6uxdk9-w7.myshopify.com/products/sac-a-pain-en-cire-dabeille-maison-auralis-format-30-x-40-cm\" class=\"eli-ing__cta-btn\">Obtenir maintenant</a>\n    <div class=\"eli-ing__cta-checks\">\n      <span>\n        <svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n        Garantie 30 jours\n      </span>\n      <span>\n        <svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n        Livraison gratuite\n      </span>\n    </div>\n  </div>\n\n</div>",
