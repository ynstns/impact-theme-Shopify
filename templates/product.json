            "liquid": "{% comment %} AURALIS — Badges confiance / Bénéfices / Avis carrousel / FAQ {% endcomment %}\n\n<link href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Playfair+Display:wght@700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .aur-section {\n    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;\n    color: #1A1A1A;\n    max-width: 640px;\n    margin: 0 auto;\n    padding: 8px 16px 8px;\n  }\n  .aur-eyebrow-wrap {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    margin-bottom: 16px;\n  }\n  .aur-eyebrow-wrap > span {\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    white-space: nowrap;\n  }\n  .aur-eyebrow-line {\n    flex: 1;\n    height: 1px;\n    background: rgba(198,139,61,0.35);\n    max-width: 60px;\n  }\n  .aur-title {\n    text-align: center;\n    font-size: clamp(24px, 5.5vw, 34px);\n    font-weight: 700;\n    line-height: 1.15;\n    margin: 0 0 6px;\n    color: #1A1A1A;\n  }\n  .aur-title em {\n    display: block;\n    font-style: italic;\n    font-weight: 400;\n    color: #C68B3D;\n  }\n  .aur-subtitle {\n    text-align: center;\n    font-size: 13.5px;\n    color: #8A7A6A;\n    margin: 0 0 28px;\n  }\n\n  /* ── BADGES DE CONFIANCE ── */\n  .aur-badges {\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    gap: 32px;\n    padding: 16px 8px 28px;\n    flex-wrap: wrap;\n  }\n  .aur-badge {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 8px;\n    max-width: 100px;\n  }\n  .aur-badge img {\n    width: 34px;\n    height: 34px;\n    object-fit: contain;\n  }\n  .aur-badge span {\n    font-size: 11px;\n    font-weight: 600;\n    text-align: center;\n    line-height: 1.3;\n    color: #1A1A1A;\n  }\n\n  /* ── BÉNÉFICES (liste) ── */\n  .aur-benefits {\n    margin-bottom: 32px;\n  }\n  .aur-benefits__list {\n    display: flex;\n    flex-direction: column;\n  }\n  .aur-benefit-row {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 13px 4px;\n    border-bottom: 1px solid rgba(26,26,26,0.08);\n  }\n  .aur-benefit-row:last-child { border-bottom: none; }\n  .aur-benefit-row__icon {\n    flex-shrink: 0;\n    width: 18px;\n    height: 18px;\n  }\n  .aur-benefit-row__icon svg {\n    width: 18px;\n    height: 18px;\n    stroke: #C68B3D;\n    fill: none;\n    stroke-width: 2;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n  .aur-benefit-row__text {\n    font-size: 14px;\n    font-weight: 600;\n    color: #1A1A1A;\n    margin: 0;\n  }\n\n  /* ── AVIS (carrousel) ── */\n  .aur-reviews {\n    margin-bottom: 32px;\n  }\n  .aur-review-carousel {\n    position: relative;\n    background: #FBF4E8;\n    border-radius: 16px;\n    padding: 18px 46px;\n  }\n  .aur-review-carousel__arrow {\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 28px;\n    height: 28px;\n    border-radius: 50%;\n    background: #FFFFFF;\n    border: 1px solid rgba(26,26,26,0.1);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .aur-review-carousel__arrow svg { width: 12px; height: 12px; stroke: #5C3A21; stroke-width: 2.2; fill: none; }\n  .aur-review-carousel__arrow--prev { left: 8px; }\n  .aur-review-carousel__arrow--next { right: 8px; }\n\n  .aur-review-slide { display: flex; gap: 14px; align-items: flex-start; }\n  .aur-review-slide__avatar {\n    width: 44px;\n    height: 44px;\n    border-radius: 50%;\n    object-fit: cover;\n    flex-shrink: 0;\n  }\n  .aur-review-slide__head {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-bottom: 4px;\n  }\n  .aur-review-slide__name {\n    font-size: 13.5px;\n    font-weight: 700;\n    color: #1A1A1A;\n    margin: 0;\n  }\n  .aur-review-slide__verified {\n    width: 14px;\n    height: 14px;\n    flex-shrink: 0;\n  }\n  .aur-review-slide__stars {\n    display: flex;\n    gap: 1px;\n    margin-bottom: 6px;\n  }\n  .aur-review-slide__stars svg { width: 13px; height: 13px; fill: #C68B3D; }\n  .aur-review-slide__text {\n    font-size: 13.5px;\n    line-height: 1.55;\n    color: #3A342E;\n    margin: 0;\n  }\n  .aur-review-slide__text strong { font-weight: 700; color: #1A1A1A; }\n\n  .aur-review-carousel__dots {\n    display: flex;\n    justify-content: center;\n    gap: 6px;\n    margin-top: 14px;\n  }\n  .aur-review-carousel__dots span {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: rgba(26,26,26,0.15);\n    cursor: pointer;\n  }\n  .aur-review-carousel__dots span.is-active { background: #C68B3D; }\n\n  /* ── FAQ ── */\n  .aur-faq {\n    margin-bottom: 8px;\n  }\n  .aur-faq__eyebrow {\n    text-align: center;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.20em;\n    text-transform: uppercase;\n    color: #C68B3D;\n    margin: 0 0 10px;\n  }\n  .aur-faq__title {\n    text-align: center;\n    font-family: 'Playfair Display', Georgia, serif;\n    font-size: clamp(20px, 5vw, 32px);\n    font-weight: 700;\n    line-height: 1.2;\n    color: #1A1A1A;\n    margin: 0 0 26px;\n    white-space: nowrap;\n  }\n  .aur-faq__list {\n    display: flex;\n    flex-direction: column;\n  }\n  .aur-faq__item {\n    border-bottom: 1px solid rgba(26,26,26,0.12);\n  }\n  .aur-faq__item:first-child { border-top: 1px solid rgba(26,26,26,0.12); }\n  .aur-faq__question {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 18px 4px;\n    cursor: pointer;\n    user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n  .aur-faq__question-text {\n    font-size: 14.5px;\n    font-weight: 600;\n    line-height: 1.35;\n    color: #1A1A1A;\n    margin: 0;\n    flex: 1;\n  }\n  .aur-faq__chevron {\n    flex-shrink: 0;\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    border: 1.5px solid #C68B3D;\n    background: transparent;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: transform 0.3s;\n  }\n  .aur-faq__item.is-open .aur-faq__chevron {\n    transform: rotate(45deg);\n  }\n  .aur-faq__chevron svg { width: 11px; height: 11px; }\n  .aur-faq__chevron svg path,\n  .aur-faq__chevron svg line {\n    stroke: #C68B3D;\n  }\n  .aur-faq__answer {\n    max-height: 0;\n    overflow: hidden;\n    transition: max-height 0.35s ease;\n  }\n  .aur-faq__item.is-open .aur-faq__answer { max-height: 600px; }\n  .aur-faq__answer-inner {\n    padding: 0 4px 18px;\n    font-size: 13.5px;\n    line-height: 1.65;\n    color: #4A4640;\n  }\n  .aur-faq__answer-inner strong { font-weight: 600; color: #5C3A21; }\n  .aur-faq__answer-inner .highlight { color: #C68B3D; font-weight: 600; }\n\n  @media (max-width: 480px) {\n    .aur-section { padding: 5px 10px 5px; }\n\n    .aur-eyebrow-wrap { margin-bottom: 9px; }\n    .aur-title { font-size: clamp(20px, 6.2vw, 25px); margin: 0 0 4px; }\n    .aur-subtitle { font-size: 12px; margin: 0 0 15px; }\n\n    /* Badges — toujours sur une seule ligne */\n    .aur-badges { gap: 8px; padding: 9px 0 15px; flex-wrap: nowrap; }\n    .aur-badge { max-width: 90px; gap: 5px; flex: 1 1 0; min-width: 0; }\n    .aur-badge img { width: 27px; height: 27px; }\n    .aur-badge span { font-size: 9.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }\n\n    /* Bénéfices */\n    .aur-benefits { margin-bottom: 11px; }\n    .aur-benefit-row { padding: 9px 2px; gap: 9px; }\n    .aur-benefit-row__icon { width: 15px; height: 15px; }\n    .aur-benefit-row__icon svg { width: 15px; height: 15px; }\n    .aur-benefit-row__text { font-size: 13px; }\n\n    /* Avis */\n    .aur-reviews { margin-bottom: 11px; }\n    .aur-review-carousel { padding: 11px 28px; border-radius: 13px; }\n    .aur-review-carousel__arrow { width: 21px; height: 21px; }\n    .aur-review-carousel__arrow svg { width: 9px; height: 9px; }\n    .aur-review-carousel__arrow--prev { left: 4px; }\n    .aur-review-carousel__arrow--next { right: 4px; }\n    .aur-review-slide { gap: 9px; }\n    .aur-review-slide__avatar { width: 34px; height: 34px; }\n    .aur-review-slide__head { margin-bottom: 2px; }\n    .aur-review-slide__name { font-size: 12px; }\n    .aur-review-slide__verified { width: 11px; height: 11px; }\n    .aur-review-slide__stars { margin-bottom: 3px; }\n    .aur-review-slide__stars svg { width: 10.5px; height: 10.5px; }\n    .aur-review-slide__text { font-size: 12px; line-height: 1.42; }\n    .aur-review-carousel__dots { margin-top: 9px; gap: 4px; }\n    .aur-review-carousel__dots span { width: 5px; height: 5px; }\n\n    /* FAQ */\n    .aur-faq__eyebrow { margin-bottom: 5px; font-size: 10.5px; }\n    .aur-faq__title { font-size: clamp(16px, 5.4vw, 24px); margin: 0 0 13px; }\n    .aur-faq__question { padding: 11px 2px; gap: 8px; }\n    .aur-faq__question-text { font-size: 13px; }\n    .aur-faq__chevron { width: 21px; height: 21px; }\n    .aur-faq__chevron svg { width: 9px; height: 9px; }\n    .aur-faq__answer-inner { padding: 0 2px 11px; font-size: 12px; }\n  }\n</style>\n\n<!-- ══════════════ BADGES DE CONFIANCE ══════════════ -->\n<div class=\"aur-section\">\n  <div class=\"aur-badges\">\n    <div class=\"aur-badge\">\n      <img src=\"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/1_15cd65e6-cbe5-489e-9a94-c7dea966d30b.png?v=1789772014\" alt=\"Paiement Sécurisé\">\n      <span>Paiement Sécurisé</span>\n    </div>\n    <div class=\"aur-badge\">\n      <img src=\"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/Design_sans_titre_1.png?v=1789772014\" alt=\"Livraison Gratuite\">\n      <span>Livraison Gratuite</span>\n    </div>\n    <div class=\"aur-badge\">\n      <img src=\"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/Design_sans_titre_3.png?v=1789772014\" alt=\"Garantie 30 jours\">\n      <span>Garantie 30 jours</span>\n    </div>\n  </div>\n</div>\n\n<!-- ══════════════ BÉNÉFICES ══════════════ -->\n<div class=\"aur-section aur-benefits\">\n  <div class=\"aur-benefits__list\">\n\n    <div class=\"aur-benefit-row\">\n      <span class=\"aur-benefit-row__icon\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></span>\n      <p class=\"aur-benefit-row__text\">Pain frais jusqu'à 7 jours</p>\n    </div>\n\n    <div class=\"aur-benefit-row\">\n      <span class=\"aur-benefit-row__icon\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></span>\n      <p class=\"aur-benefit-row__text\">Préserve le croustillant et le moelleux</p>\n    </div>\n\n    <div class=\"aur-benefit-row\">\n      <span class=\"aur-benefit-row__icon\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></span>\n      <p class=\"aur-benefit-row__text\">Réduit le gaspillage alimentaire</p>\n    </div>\n\n    <div class=\"aur-benefit-row\">\n      <span class=\"aur-benefit-row__icon\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></span>\n      <p class=\"aur-benefit-row__text\">Fabriqué à la main, qualité supérieure</p>\n    </div>\n\n    <div class=\"aur-benefit-row\">\n      <span class=\"aur-benefit-row__icon\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></span>\n      <p class=\"aur-benefit-row__text\">Régule naturellement l'humidité</p>\n    </div>\n\n    <div class=\"aur-benefit-row\">\n      <span class=\"aur-benefit-row__icon\"><svg viewBox=\"0 0 24 24\"><polyline points=\"20 6 9 17 4 12\"/></svg></span>\n      <p class=\"aur-benefit-row__text\">Lavable à la main et en machine</p>\n    </div>\n\n  </div>\n</div>\n\n<!-- ══════════════ AVIS (carrousel) ══════════════ -->\n<div class=\"aur-section aur-reviews\">\n  <div class=\"aur-review-carousel\">\n    <div class=\"aur-review-carousel__arrow aur-review-carousel__arrow--prev\" id=\"aurRevPrev\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M15 6l-6 6 6 6\"/></svg>\n    </div>\n    <div class=\"aur-review-carousel__arrow aur-review-carousel__arrow--next\" id=\"aurRevNext\">\n      <svg viewBox=\"0 0 24 24\"><path d=\"M9 6l6 6-6 6\"/></svg>\n    </div>\n\n    <div id=\"aurRevSlide\" class=\"aur-review-slide\">\n      <!-- rempli par le script -->\n    </div>\n\n    <div class=\"aur-review-carousel__dots\" id=\"aurRevDots\"></div>\n  </div>\n</div>\n\n<!-- ══════════════ FAQ ══════════════ -->\n<div class=\"aur-section aur-faq\">\n  <p class=\"aur-faq__eyebrow\">Informations utiles</p>\n  <h2 class=\"aur-faq__title\">Vos questions. Nos réponses.</h2>\n\n  <div class=\"aur-faq__list\">\n\n    <div class=\"aur-faq__item\">\n      <div class=\"aur-faq__question\">\n        <p class=\"aur-faq__question-text\">Est-ce que le pain reste vraiment frais plus longtemps ?</p>\n        <span class=\"aur-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><line x1=\"7\" y1=\"2\" x2=\"7\" y2=\"12\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><line x1=\"2\" y1=\"7\" x2=\"12\" y2=\"7\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n      <div class=\"aur-faq__answer\">\n        <div class=\"aur-faq__answer-inner\">\n          <strong>Oui.</strong> La cire d'abeille crée une barrière respirante qui régule l'humidité : le pain garde sa croûte croustillante et sa mie moelleuse <span class=\"highlight\">jusqu'à 7 jours</span>, contre 1 à 2 jours dans un sac plastique classique.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"aur-faq__item\">\n      <div class=\"aur-faq__question\">\n        <p class=\"aur-faq__question-text\">Est-ce que le sac donne une odeur ou un goût au pain ?</p>\n        <span class=\"aur-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><line x1=\"7\" y1=\"2\" x2=\"7\" y2=\"12\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><line x1=\"2\" y1=\"7\" x2=\"12\" y2=\"7\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n      <div class=\"aur-faq__answer\">\n        <div class=\"aur-faq__answer-inner\">\n          <strong>Non.</strong> La cire d'abeille utilisée est <span class=\"highlight\">neutre en goût et en odeur</span>. Elle n'entre jamais directement en contact prolongé avec la mie et n'altère en rien le goût du pain.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"aur-faq__item\">\n      <div class=\"aur-faq__question\">\n        <p class=\"aur-faq__question-text\">Est-ce que le sac dure vraiment dans le temps ?</p>\n        <span class=\"aur-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><line x1=\"7\" y1=\"2\" x2=\"7\" y2=\"12\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><line x1=\"2\" y1=\"7\" x2=\"12\" y2=\"7\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n      <div class=\"aur-faq__answer\">\n        <div class=\"aur-faq__answer-inner\">\n          <strong>Oui.</strong> Fabriqué à la main en coton bio et cire d'abeille, il est conçu pour un usage quotidien pendant <span class=\"highlight\">plus d'un an</span>. Un entretien simple (eau froide, sans lave-vaisselle) suffit à le préserver.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"aur-faq__item\">\n      <div class=\"aur-faq__question\">\n        <p class=\"aur-faq__question-text\">Est-ce que tous les pains rentrent dedans ?</p>\n        <span class=\"aur-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><line x1=\"7\" y1=\"2\" x2=\"7\" y2=\"12\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><line x1=\"2\" y1=\"7\" x2=\"12\" y2=\"7\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n      <div class=\"aur-faq__answer\">\n        <div class=\"aur-faq__answer-inner\">\n          Le sac mesure <strong>30 x 40 cm</strong>, une taille adaptée à la plupart des pains : baguette, pain de campagne, boule ou pain complet. Pour les très grosses pièces, il suffit de plier légèrement le pain.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"aur-faq__item\">\n      <div class=\"aur-faq__question\">\n        <p class=\"aur-faq__question-text\">Est-ce que je peux le mettre au réfrigérateur ?</p>\n        <span class=\"aur-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><line x1=\"7\" y1=\"2\" x2=\"7\" y2=\"12\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><line x1=\"2\" y1=\"7\" x2=\"12\" y2=\"7\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n      <div class=\"aur-faq__answer\">\n        <div class=\"aur-faq__answer-inner\">\n          <strong>Ce n'est pas nécessaire</strong>, et même déconseillé : le froid du réfrigérateur accélère le rassissement du pain. Le sac Auralis est conçu pour une conservation optimale <span class=\"highlight\">à température ambiante</span>, à l'abri de la lumière directe.\n        </div>\n      </div>\n    </div>\n\n    <div class=\"aur-faq__item\">\n      <div class=\"aur-faq__question\">\n        <p class=\"aur-faq__question-text\">Et si je ne suis pas satisfait ?</p>\n        <span class=\"aur-faq__chevron\"><svg viewBox=\"0 0 14 14\" fill=\"none\"><line x1=\"7\" y1=\"2\" x2=\"7\" y2=\"12\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><line x1=\"2\" y1=\"7\" x2=\"12\" y2=\"7\" stroke=\"#C68B3D\" stroke-width=\"1.6\" stroke-linecap=\"round\"/></svg></span>\n      </div>\n      <div class=\"aur-faq__answer\">\n        <div class=\"aur-faq__answer-inner\">\n          Votre satisfaction est garantie. Vous disposez de <span class=\"highlight\">30 jours</span> après réception pour nous contacter et être remboursé si le produit ne vous convient pas.\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  // FAQ accordion\n  document.querySelectorAll('.aur-faq__question').forEach(function(btn) {\n    btn.addEventListener('click', function() {\n      var item = btn.closest('.aur-faq__item');\n      var isOpen = item.classList.contains('is-open');\n      document.querySelectorAll('.aur-faq__item.is-open').forEach(function(el) {\n        el.classList.remove('is-open');\n      });\n      if (!isOpen) { item.classList.add('is-open'); }\n    });\n  });\n\n  // Avis carrousel\n  var aurReviews = [\n    {\n      avatar: \"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/262120138_5135161053168911_4317808011404363710_n.webp?v=1789772109\",\n      name: \"Camille D.\",\n      text: \"Je jetais la moitié de ma baguette au bout de deux jours avant. Avec le sac Auralis, elle est <strong>encore bonne le 5e jour</strong>.\"\n    },\n    {\n      avatar: \"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/440963873_10228932907180188_5795405126749105216_n.jpg?v=1789772110\",\n      name: \"Julien M.\",\n      text: \"La finition est vraiment soignée, on sent que c'est <strong>fait main</strong>. Il passe en machine sans problème.\"\n    },\n    {\n      avatar: \"https://cdn.shopify.com/s/files/1/1022/7109/1070/files/70808168_2543092175756262_7125276819086901248_n.jpg?v=1789772110\",\n      name: \"Sophie L.\",\n      text: \"Plus aucune odeur de plastique sur le pain, et il <strong>reste croustillant</strong> bien plus longtemps.\"\n    }\n  ];\n\n  var aurRevIndex = 0;\n  var aurRevSlide = document.getElementById('aurRevSlide');\n  var aurRevDots = document.getElementById('aurRevDots');\n\n  function aurStarsSVG() {\n    var s = '';\n    for (var i = 0; i < 5; i++) {\n      s += '<svg viewBox=\"0 0 20 20\"><polygon points=\"10 1 12.6 6.9 19 7.6 14.2 11.9 15.6 18.2 10 15 4.4 18.2 5.8 11.9 1 7.6 7.4 6.9\"/></svg>';\n    }\n    return s;\n  }\n\n  function aurRenderReview() {\n    var r = aurReviews[aurRevIndex];\n    aurRevSlide.innerHTML =\n      '<img class=\"aur-review-slide__avatar\" src=\"' + r.avatar + '\" alt=\"' + r.name + '\">' +\n      '<div>' +\n        '<div class=\"aur-review-slide__head\">' +\n          '<p class=\"aur-review-slide__name\">' + r.name + '</p>' +\n          '<svg class=\"aur-review-slide__verified\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"#C68B3D\"/><path d=\"M8 12l2.5 2.5L16 9\" stroke=\"#FFFFFF\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>' +\n        '</div>' +\n        '<div class=\"aur-review-slide__stars\">' + aurStarsSVG() + '</div>' +\n        '<p class=\"aur-review-slide__text\">&laquo; ' + r.text + ' &raquo;</p>' +\n      '</div>';\n\n    aurRevDots.innerHTML = '';\n    aurReviews.forEach(function(_, i) {\n      var dot = document.createElement('span');\n      if (i === aurRevIndex) dot.classList.add('is-active');\n      dot.addEventListener('click', function() { aurRevIndex = i; aurRenderReview(); });\n      aurRevDots.appendChild(dot);\n    });\n  }\n\n  document.getElementById('aurRevPrev').addEventListener('click', function() {\n    aurRevIndex = (aurRevIndex - 1 + aurReviews.length) % aurReviews.length;\n    aurRenderReview();\n  });\n  document.getElementById('aurRevNext').addEventListener('click', function() {\n    aurRevIndex = (aurRevIndex + 1) % aurReviews.length;\n    aurRenderReview();\n  });\n\n  aurRenderReview();\n</script>"
          }
        }
      },
